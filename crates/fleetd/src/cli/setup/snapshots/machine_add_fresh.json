[
  {
    "command": "mkdir -p /home/ada/.fleetd/node /home/ada/.fleetd/logs /home/ada/.fleetd/bin && chmod 700 /home/ada/.fleetd",
    "title": "create fleetd's directories"
  },
  {
    "command": "mkdir -p /home/ada/.fleetd/bin && cat > /home/ada/.fleetd/bin/fleetd.fleetd-tmp && chmod 755 /home/ada/.fleetd/bin/fleetd.fleetd-tmp && mv /home/ada/.fleetd/bin/fleetd.fleetd-tmp /home/ada/.fleetd/bin/fleetd && rm -rf /home/ada/.local/share/fleetd/bin /home/ada/.local/share/fleetd/cli",
    "stdin": "binary",
    "title": "install fleetd 0.0.0"
  },
  {
    "command": "mkdir -p /home/ada/.config/systemd/user && cat > /home/ada/.config/systemd/user/fleetd-node.service.fleetd-tmp && chmod 644 /home/ada/.config/systemd/user/fleetd-node.service.fleetd-tmp && mv /home/ada/.config/systemd/user/fleetd-node.service.fleetd-tmp /home/ada/.config/systemd/user/fleetd-node.service",
    "stdin": "text",
    "title": "write the node service"
  },
  {
    "command": "/home/ada/.fleetd/bin/fleetd node join --hub https://devbox.example.ts.net --token-file - --machine mac-mini --tags macos,xcode --home /home/ada/.fleetd/node --enroll-only",
    "stdin": "enrollToken",
    "title": "enroll the node with a one-time token (sent on stdin)"
  },
  {
    "command": "XDG_RUNTIME_DIR=/run/user/1000 systemctl --user enable fleetd-node.service && XDG_RUNTIME_DIR=/run/user/1000 systemctl --user restart fleetd-node.service",
    "title": "(re)start the node"
  }
]
