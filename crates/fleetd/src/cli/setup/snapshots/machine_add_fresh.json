[
  {
    "command": "mkdir -p /home/wynn/.fleetd/node /home/wynn/.fleetd/claude /home/wynn/.fleetd/logs /home/wynn/.fleetd/bin && chmod 700 /home/wynn/.fleetd /home/wynn/.fleetd/claude",
    "title": "create fleetd's directories"
  },
  {
    "command": "mkdir -p /home/wynn/.fleetd/bin && cat > /home/wynn/.fleetd/bin/fleetd.fleetd-tmp && chmod 755 /home/wynn/.fleetd/bin/fleetd.fleetd-tmp && mv /home/wynn/.fleetd/bin/fleetd.fleetd-tmp /home/wynn/.fleetd/bin/fleetd && rm -rf /home/wynn/.local/share/fleetd/bin /home/wynn/.local/share/fleetd/cli /home/wynn/.local/share/fleetd/npm",
    "stdin": "binary",
    "title": "install fleetd 0.0.0"
  },
  {
    "command": "[ -e /home/wynn/.fleetd/claude.env ] || (umask 077 && : > /home/wynn/.fleetd/claude.env)",
    "title": "create fleetd's Claude login file (empty, 0600)"
  },
  {
    "command": "mkdir -p /home/wynn/.config/systemd/user && cat > /home/wynn/.config/systemd/user/fleetd-node.service.fleetd-tmp && chmod 644 /home/wynn/.config/systemd/user/fleetd-node.service.fleetd-tmp && mv /home/wynn/.config/systemd/user/fleetd-node.service.fleetd-tmp /home/wynn/.config/systemd/user/fleetd-node.service",
    "stdin": "text",
    "title": "write the node service"
  },
  {
    "command": "/home/wynn/.fleetd/bin/fleetd node join --hub https://forge.example.ts.net --token-file - --machine mac-mini --tags macos,xcode --home /home/wynn/.fleetd/node --enroll-only",
    "stdin": "enrollToken",
    "title": "enroll the node with a one-time token (sent on stdin)"
  },
  {
    "command": "XDG_RUNTIME_DIR=/run/user/1000 systemctl --user enable fleetd-node.service && XDG_RUNTIME_DIR=/run/user/1000 systemctl --user restart fleetd-node.service",
    "title": "(re)start the node"
  }
]
