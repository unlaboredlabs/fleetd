{
  "$defs": {
    "Activity": {
      "description": "What a lane is doing now, literally.",
      "oneOf": [
        {
          "description": "The command's first line, `cd x &&` stripped.",
          "properties": {
            "kind": {
              "const": "command",
              "type": "string"
            },
            "text": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Repo-relative.",
          "properties": {
            "kind": {
              "const": "edit",
              "type": "string"
            },
            "path": {
              "maxLength": 200,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "A file read, or a search when `pattern` is set.",
          "properties": {
            "kind": {
              "const": "read",
              "type": "string"
            },
            "path": {
              "maxLength": 200,
              "type": "string"
            },
            "pattern": {
              "maxLength": 120,
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "detail": {
              "maxLength": 120,
              "type": "string"
            },
            "kind": {
              "const": "tool",
              "type": "string"
            },
            "name": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Assistant text streamed in the last 3 s.",
          "properties": {
            "kind": {
              "const": "writing",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A run is active with nothing open and no text for 3 s: waiting on the model.",
          "properties": {
            "kind": {
              "const": "thinking",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "compacting",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "attempt": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "retrying",
              "type": "string"
            },
            "of": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "maxLength": 80,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "attempt",
            "of",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ActivityNow": {
      "properties": {
        "activity": {
          "$ref": "#/$defs/Activity"
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "activity",
        "since"
      ],
      "type": "object"
    },
    "AppError": {
      "description": "A `call` failed, or (without `id`) the session did.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "fix": {
          "type": "string"
        },
        "id": {
          "description": "Present when this answers a `call`.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "AppServerMessage": {
      "oneOf": [
        {
          "description": "Sent once the key is accepted.",
          "properties": {
            "protocol": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "t": {
              "const": "ready",
              "type": "string"
            },
            "version": {
              "description": "The hub's fleetd version, as hub_info reports it. Absent from older hubs.",
              "type": "string"
            }
          },
          "required": [
            "t",
            "protocol"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/FleetStatus",
          "description": "Answer to `snapshot`: the fleetd_status data.",
          "properties": {
            "t": {
              "const": "snapshot",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/HubEvent",
          "properties": {
            "t": {
              "const": "event",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        },
        {
          "description": "A `call` succeeded; `output` is the tool's output.",
          "properties": {
            "id": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "output": true,
            "t": {
              "const": "result",
              "type": "string"
            }
          },
          "required": [
            "t",
            "id",
            "output"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AppError",
          "properties": {
            "t": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/LiveFrame",
          "description": "On the live subscription only. Ephemeral: a slow link drops intermediate frames.",
          "properties": {
            "t": {
              "const": "live",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ChatDelta",
          "description": "On the chat subscription only: the lead's reply as it streams. Ephemeral and never replayed.",
          "properties": {
            "t": {
              "const": "chat_delta",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        }
      ]
    },
    "Attention": {
      "description": "Whether an event needs the human now, set by the hub when it emits the event. \"loud\": notify, but hold it through\nquiet hours; \"urgent\": notify even during quiet hours (money and irreversible). Absent: the inbox and the digest\nare enough.",
      "enum": [
        "loud",
        "urgent"
      ],
      "type": "string"
    },
    "BoxPublicKey": {
      "type": "string"
    },
    "ChatDelta": {
      "description": "Streamed text of the subscribed chat's lead message `messageId`. `offset` is the message's text length before\n`append`, in UTF-16 units: append when it equals the length the app holds, skip the frame when\n`offset + append.length` is within it (already applied, e.g. after a `chat_history` read), and read the message\nagain otherwise (a gap). The `chat.message` event with `state: final` carries the full text.",
      "properties": {
        "append": {
          "maxLength": 4000,
          "type": "string"
        },
        "messageId": {
          "$ref": "#/$defs/ChatMessageId"
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "projectRef",
        "messageId",
        "seq",
        "offset",
        "append"
      ],
      "type": "object"
    },
    "ChatMessageId": {
      "pattern": "^m[1-9][0-9]*$",
      "type": "string"
    },
    "ErrorCode": {
      "enum": [
        "machine_offline",
        "not_found",
        "forbidden",
        "invalid",
        "failed"
      ],
      "type": "string"
    },
    "EventSeq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "FleetStatus": {
      "properties": {
        "attention": {
          "description": "Latest failed, waiting and usage-limited events, and PRs the merge train sent back to their authors.",
          "items": {
            "$ref": "#/$defs/HubEvent"
          },
          "maxItems": 10,
          "type": "array"
        },
        "chats": {
          "description": "Each project's chat: whether its lead waits on you, whether it works. Absent from hubs without chat.",
          "items": {
            "$ref": "#/$defs/ProjectChatState"
          },
          "maxItems": 50,
          "type": "array"
        },
        "cursor": {
          "$ref": "#/$defs/EventSeq"
        },
        "machines": {
          "items": {
            "$ref": "#/$defs/Machine"
          },
          "type": "array"
        },
        "notify": {
          "$ref": "#/$defs/NotifyPolicy",
          "description": "When to notify the human; absent from older hubs."
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/ProjectSummary"
          },
          "maxItems": 50,
          "type": "array"
        },
        "slots": {
          "$ref": "#/$defs/SlotState",
          "description": "Absent until the hub runs the slot board (M5)."
        }
      },
      "required": [
        "machines",
        "projects",
        "attention",
        "cursor"
      ],
      "type": "object"
    },
    "HubEvent": {
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "attention": {
          "$ref": "#/$defs/Attention"
        },
        "data": {
          "description": "At most 2 KB of JSON; the hub trims before emitting."
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "seq": {
          "$ref": "#/$defs/EventSeq",
          "description": "Hub-global and monotonic."
        },
        "summary": {
          "description": "Plain language.",
          "maxLength": 200,
          "type": "string"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "type": {
          "$ref": "#/$defs/HubEventType"
        }
      },
      "required": [
        "seq",
        "at",
        "type",
        "summary"
      ],
      "type": "object"
    },
    "HubEventType": {
      "oneOf": [
        {
          "enum": [
            "machine.online",
            "machine.offline",
            "machine.degraded",
            "thread.started",
            "thread.completed",
            "thread.failed",
            "thread.interrupted",
            "thread.usage_limited",
            "wake.fired",
            "workstream.created",
            "workstream.state",
            "decision.recorded",
            "lead.started",
            "lead.woken",
            "task.started",
            "task.completed",
            "task.failed",
            "task.cancelled",
            "steer.withdrawn"
          ],
          "type": "string"
        },
        {
          "const": "machine.slept",
          "description": "The machine's node woke from sleep; `data.fromMs`, `data.toMs` (epoch milliseconds).",
          "type": "string"
        },
        {
          "const": "machine.guard",
          "description": "The machine's disk or load stopped new agents there, or no longer does; `data.paused`, and the summary says\nwhy. Agents already running keep going.",
          "type": "string"
        },
        {
          "const": "project.removed",
          "description": "The node no longer has the project: the hub dropped it from its cache, and its open workstreams stop. `data.title`.",
          "type": "string"
        },
        {
          "const": "project.added",
          "description": "A project was added from a path or a finished clone: `data` is `ProjectAddedData` (the inspect line included).",
          "type": "string"
        },
        {
          "const": "project.clone_progress",
          "description": "A clone `project_add` accepted is running: `data` is `CloneProgressData`. Throttled; never stored past the\nevent log's own retention.",
          "type": "string"
        },
        {
          "const": "project.add_failed",
          "description": "A clone `project_add` accepted failed: `data` is `ProjectAddFailedData`, with the fix.",
          "type": "string"
        },
        {
          "const": "project.settings",
          "description": "A project's settings changed (`project_set`): `data.mediumAllowed`.",
          "type": "string"
        },
        {
          "const": "thread.waiting",
          "description": "Needs approval or user input.",
          "type": "string"
        },
        {
          "const": "wake.missed",
          "description": "A wake missed while the hub was down, with catchUp \"skip\".",
          "type": "string"
        },
        {
          "const": "write.delivered",
          "description": "A queued write to an offline machine was delivered when it came back.",
          "type": "string"
        },
        {
          "const": "write.expired",
          "description": "A queued write outlived its TTL and was dropped.",
          "type": "string"
        },
        {
          "const": "workstream.running",
          "description": "The brief was set and the work started.",
          "type": "string"
        },
        {
          "const": "request.opened",
          "description": "A lead needs a person for a secret or an approval; `data` is the request (RequestEventData).",
          "type": "string"
        },
        {
          "const": "request.updated",
          "description": "A request changed state (stored, declined, approved, running, done, failed, denied, or open again when it could\nnot run); `data` as request.opened.",
          "type": "string"
        },
        {
          "const": "task.queued",
          "description": "`data.queuedReason`.",
          "type": "string"
        },
        {
          "const": "agents.cap",
          "description": "A project's max agents or the fleet cap changed; `data` is `tasks::AgentsCapData`, `summary` the chat's line.",
          "type": "string"
        },
        {
          "const": "workstream.done",
          "description": "The lead closed it. `data.workstreamId`, `data.reason` (why) and `data.by`.",
          "type": "string"
        },
        {
          "const": "review.verdict",
          "description": "`data.taskId`, `data.prHeadSha`, `data.blocking`.",
          "type": "string"
        },
        {
          "const": "change.queued",
          "description": "`data.changeId`, `data.repo`, `data.prNumber`.",
          "type": "string"
        },
        {
          "const": "change.ready",
          "description": "A clean review is bound to its current patch id. `data.changeId`.",
          "type": "string"
        },
        {
          "const": "change.needs_rebase",
          "description": "The PR conflicts with its base, or with the PRs ahead of it in a batch; `data.changeId`.",
          "type": "string"
        },
        {
          "const": "change.ci_failed",
          "description": "`data.changeId`, `data.checks` (failing check names), `data.logUrl`.",
          "type": "string"
        },
        {
          "const": "pr.merged",
          "description": "`data.changeId`, `data.repo`, `data.prNumber`, `data.mergedSha`; `data.ci` when the repo had no CI and the\ntrain merged on fleetd's own checks.",
          "type": "string"
        },
        {
          "const": "pr.merged_outside",
          "description": "A PR was merged into a base the train guards without the train; `data.repo`, `data.prNumber`,\n`data.mergedSha`, and `data.changeId` when it had been enqueued.",
          "type": "string"
        },
        {
          "const": "change.refused",
          "description": "Refused at enqueue; `data.prUrl`, `data.fix`.",
          "type": "string"
        },
        {
          "const": "usage.breaker",
          "description": "M4: a machine's login hit the same limit on several threads, or its proxy has no account; dispatch there pauses.",
          "type": "string"
        },
        {
          "const": "usage.resumed",
          "description": "M4: parked threads were sent \"continue\" at their reset or on usage_resume; `data.breakerCleared`.",
          "type": "string"
        },
        {
          "const": "doctor.changed",
          "description": "M11: doctor checks changed status; `data.changes` lists `{ id, from, to }` (from absent on the first run).",
          "type": "string"
        },
        {
          "const": "key.paired",
          "description": "A device redeemed a pairing code from `fleetd pair` and got a human key; `data.keyId`, `data.deviceName`.",
          "type": "string"
        },
        {
          "const": "prompt.changed",
          "description": "A prompt override was saved or reset: `data.id`, `data.scope`, `data.projectRef`, `data.ref` (absent on reset),\n`data.warnings` (their codes). The text is not in the event; prompt_get reads it.",
          "type": "string"
        },
        {
          "const": "prompt.default_changed",
          "description": "This release changed the default of a prompt you overrode; yours stays in effect until you save it again or\nreset it: `data.id`, `data.scope`, `data.projectRef`, `data.base`, `data.current`.",
          "type": "string"
        },
        {
          "const": "steer.queued",
          "description": "A steer was stored (or put in the offline queue). `data` is a `SteerEventData`, plus `data.text` (first 120\ncharacters), `data.mode` and `data.by`.",
          "type": "string"
        },
        {
          "const": "steer.delivered",
          "description": "claude took the steer in; `data.how`.",
          "type": "string"
        },
        {
          "const": "steer.acknowledged",
          "description": "The agent replied after taking it in (`data.excerpt`), or a lead call named it.",
          "type": "string"
        },
        {
          "const": "steer.unacknowledged",
          "description": "The steer's run ended with no reply after it was delivered.",
          "type": "string"
        },
        {
          "const": "steer.failed",
          "description": "Refused by the node, the process exited before taking it in, or it expired in the offline queue;\n`data.reason`.",
          "type": "string"
        },
        {
          "const": "plan.changed",
          "description": "A plan's scope changed and a marker was written; `data` is the `PlanChange` (`status::PlanChangedData`).",
          "type": "string"
        },
        {
          "const": "plan.verified",
          "description": "The hub verified a plan item done; `data.itemId`, `data.milestoneId`, `data.workstreamId`, `data.evidence`.",
          "type": "string"
        },
        {
          "const": "change.state",
          "description": "A merge-train Change moved between states; `data.changeId`, `data.workstreamId`, `data.repo`, `data.prNumber`,\n`data.from`, `data.to`.",
          "type": "string"
        },
        {
          "const": "ci.main",
          "description": "Main-branch CI of a train repo changed state; `data.repo`, `data.sha`, `data.state`, `data.failing`.",
          "type": "string"
        },
        {
          "const": "source.stale",
          "description": "A status source went quiet past its cadence; `data.source`, `data.sinceMs`, `data.reason`.",
          "type": "string"
        },
        {
          "const": "source.fresh",
          "description": "A stale source answered again; `data.source`, `data.staleMs`.",
          "type": "string"
        },
        {
          "const": "chat.message",
          "description": "A project's chat got a message, or one of its messages finished streaming or had an inline item change state;\n`data` is `chat::ChatMessageEventData`.",
          "type": "string"
        },
        {
          "const": "chat.waiting",
          "description": "A project's chat started or stopped waiting on you, or its lead started or ended a turn; `data` is the\n`chat::ProjectChatState`.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "LaneStatus": {
      "oneOf": [
        {
          "enum": [
            "queued",
            "starting",
            "working",
            "stalled",
            "idle",
            "done",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "waiting",
          "description": "A permission prompt waits on a person.",
          "type": "string"
        },
        {
          "const": "parked",
          "description": "Usage limit: resumes at the reset.",
          "type": "string"
        }
      ]
    },
    "LiveFrame": {
      "description": "Hub -> app on the live subscription. Board lanes at most 1/s, focus lanes and text at most 4/s; machines at most\nevery 5 s and slots at most 1/s, each only when changed. A slow link skips frames (latest wins), never queues them.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp",
          "description": "The hub's clock; the app derives its skew from it."
        },
        "full": {
          "description": "The first frame after a (re)subscribe: every lane in scope. Lanes not in a full frame are gone.",
          "type": "boolean"
        },
        "lanes": {
          "items": {
            "$ref": "#/$defs/LiveLane"
          },
          "maxItems": 64,
          "type": "array"
        },
        "machines": {
          "description": "Present when any machine changed (always in a full frame).",
          "items": {
            "$ref": "#/$defs/MachineLive"
          },
          "maxItems": 20,
          "type": "array"
        },
        "slots": {
          "$ref": "#/$defs/SlotState",
          "description": "Present when the slot board changed (always in a full frame, once the hub runs slots)."
        },
        "text": {
          "default": [],
          "description": "Focus only.",
          "items": {
            "$ref": "#/$defs/LiveText"
          },
          "maxItems": 4,
          "type": "array"
        }
      },
      "required": [
        "at",
        "full",
        "lanes"
      ],
      "type": "object"
    },
    "LiveLane": {
      "description": "One lane's live values. In a frame that is not `full`, only lanes that changed are sent.",
      "properties": {
        "activity": {
          "$ref": "#/$defs/ActivityNow",
          "description": "Absent: nothing to say (no run active, or no recent model output; the UI says no more than the status)."
        },
        "laneId": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "spark": {
          "$ref": "#/$defs/Spark",
          "description": "Absent: unchanged since the last frame (always present in a `full` frame for lanes that have one)."
        },
        "status": {
          "$ref": "#/$defs/LaneStatus"
        },
        "tokens": {
          "$ref": "#/$defs/Tokens"
        }
      },
      "required": [
        "laneId",
        "status"
      ],
      "type": "object"
    },
    "LiveText": {
      "description": "Streamed assistant text of the focused order's lanes and lead: append to `message_id`'s text. The complete\nmessage replaces it when the thread tail is refetched.",
      "properties": {
        "append": {
          "maxLength": 2000,
          "type": "string"
        },
        "laneId": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "messageId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "laneId",
        "messageId",
        "append"
      ],
      "type": "object"
    },
    "LoginLimit": {
      "description": "One claude.ai usage window, as claude's `rate_limit_event` last reported it.",
      "properties": {
        "limitType": {
          "description": "claude's own name for the window, e.g. \"five_hour\", \"seven_day\".",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "observedAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "When claude reported it; absent from older nodes. Without it a reading's age is unknown."
        },
        "resetsAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "description": "allowed, allowed_warning or rejected.",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "utilization": {
          "description": "0 to 1 as claude sends it; absent when it sent none.",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "limitType",
        "status"
      ],
      "type": "object"
    },
    "Machine": {
      "properties": {
        "boxPubKey": {
          "$ref": "#/$defs/BoxPublicKey",
          "description": "M8: the node's X25519 key from its hello; clients seal this machine's secrets to it. Absent: it takes no\nsecrets."
        },
        "degradedReason": {
          "description": "Plain language, set while status is \"degraded\".",
          "type": "string"
        },
        "lastSeenAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastSlept": {
          "$ref": "#/$defs/SleptSpan",
          "description": "The machine's latest sleep its node reported on waking."
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "name": {
          "type": "string"
        },
        "nodeVersion": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MachineStatus"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "machineId",
        "name",
        "tags",
        "status",
        "lastSeenAt",
        "nodeVersion"
      ],
      "type": "object"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "MachineLive": {
      "description": "A machine's load and running agents, from its heartbeat (every 15 s) and the hub's executors.",
      "properties": {
        "asOf": {
          "$ref": "#/$defs/Timestamp"
        },
        "load": {
          "$ref": "#/$defs/NodeLoad",
          "description": "Absent: the node does not report load (older node, or the read failed). Show no load then."
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "name": {
          "maxLength": 200,
          "type": "string"
        },
        "running": {
          "description": "Agent turns running there now.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "slept": {
          "$ref": "#/$defs/SleptSpan",
          "description": "Its latest sleep; show it while recent ([`crate::model::SleptSpan::recent_text`])."
        },
        "status": {
          "$ref": "#/$defs/MachineStatus"
        }
      },
      "required": [
        "machineId",
        "name",
        "status",
        "running",
        "asOf"
      ],
      "type": "object"
    },
    "MachineStatus": {
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "type": "string"
    },
    "NodeDisk": {
      "description": "Space on the volume holding a node's worktrees and build cache.",
      "properties": {
        "freeBytes": {
          "description": "Free for the node's user.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "minFreeBytes": {
          "description": "Below this the hub starts no new agents there: node.json's `minFreeGb`, else 10% of the volume or 20 GB,\nwhichever is larger.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "totalBytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "freeBytes",
        "totalBytes",
        "minFreeBytes"
      ],
      "type": "object"
    },
    "NodeLoad": {
      "description": "What a machine reports about itself with each heartbeat.",
      "properties": {
        "cpus": {
          "description": "Logical CPUs.",
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "disk": {
          "$ref": "#/$defs/NodeDisk",
          "description": "The volume holding the node's worktrees and build cache; absent from older nodes and when it can't be read."
        },
        "limits": {
          "default": [],
          "description": "The latest claude.ai subscription limit of each type claude reported. Empty behind API keys and gateways,\nwhich send none.",
          "items": {
            "$ref": "#/$defs/LoginLimit"
          },
          "maxItems": 4,
          "type": "array"
        },
        "load1": {
          "description": "The 1-minute load average.",
          "minimum": 0,
          "type": "number"
        },
        "memUsedPct": {
          "description": "Memory in use (total minus available), percent.",
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpus",
        "load1"
      ],
      "type": "object"
    },
    "NotifyPolicy": {
      "description": "When a client may interrupt the human with an event marked `attention`. Quiet windows are absolute times the\nhub computes from `policy.quiet_hours` in `policy.tz`: the one under way (if any) and the next.",
      "properties": {
        "coalesceSec": {
          "description": "At most one notification per this many seconds; what arrives meanwhile is folded into the next.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "quiet": {
          "description": "Only \"urgent\" events notify inside these; empty when quiet hours are off. Ask again after the last one ends\nor on decision.recorded.",
          "items": {
            "$ref": "#/$defs/QuietWindow"
          },
          "maxItems": 2,
          "type": "array"
        }
      },
      "required": [
        "coalesceSec",
        "quiet"
      ],
      "type": "object"
    },
    "ProjectChatState": {
      "description": "One chat's state, for the sidebar and the status row.",
      "properties": {
        "lastMessageAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastSeq": {
          "description": "The newest message's `seq`; 0 for an empty chat.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "leadWorking": {
          "description": "The lead is mid-turn.",
          "type": "boolean"
        },
        "needsYou": {
          "description": "The lead's last message waits for a human reply, or an inline item is open.",
          "type": "boolean"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        }
      },
      "required": [
        "projectRef",
        "needsYou",
        "leadWorking",
        "lastSeq"
      ],
      "type": "object"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "ProjectSummary": {
      "properties": {
        "lastActivityAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "threads": {
          "$ref": "#/$defs/ThreadCounts"
        },
        "title": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        }
      },
      "required": [
        "machineId",
        "projectId",
        "title",
        "workspaceRoot",
        "threads",
        "lastActivityAt"
      ],
      "type": "object"
    },
    "QuietWindow": {
      "properties": {
        "from": {
          "$ref": "#/$defs/Timestamp"
        },
        "to": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "SleptSpan": {
      "description": "A span a machine spent asleep, epoch milliseconds; `machine.slept` carries the same fields as its data.",
      "properties": {
        "fromMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fromMs",
        "toMs"
      ],
      "type": "object"
    },
    "SlotState": {
      "properties": {
        "cap": {
          "description": "The fleet cap: agents running at once across every project.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "perProject": {
          "items": {
            "$ref": "#/$defs/SlotStatePerProject"
          },
          "maxItems": 50,
          "type": "array"
        },
        "queued": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "used": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cap",
        "used",
        "queued",
        "perProject"
      ],
      "type": "object"
    },
    "SlotStatePerProject": {
      "properties": {
        "maxAgents": {
          "description": "The most of the project's agents (its tasks: writers, readers, reviewers) that run at once; its lead is not\none. The fleet `cap` until set.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "queued": {
          "description": "Its agents waiting for a slot, paused ones included.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "description": "Its agents running now. Above `maxAgents` right after the cap was lowered: nothing is stopped for it.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "projectRef",
        "maxAgents",
        "running",
        "queued"
      ],
      "type": "object"
    },
    "Spark": {
      "description": "Work per 2 s bucket, oldest first, ending with the bucket that ends at `end_at`. A sample is\n`min(255, 16 × items started + streamed chars / 32 + output tokens not streamed as text / 8)`; a bucket with\nno frames is 0.",
      "properties": {
        "endAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "samples": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 30,
          "type": "array"
        }
      },
      "required": [
        "endAt",
        "samples"
      ],
      "type": "object"
    },
    "ThreadCounts": {
      "properties": {
        "failed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "idle": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "waiting": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "running",
        "waiting",
        "idle",
        "failed"
      ],
      "type": "object"
    },
    "ThreadId": {
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "Tokens": {
      "description": "Summed over the lane's runs. `live`: the running run's usage is streaming in (else it updates at each run's end).",
      "properties": {
        "cacheRead": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "input": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "live": {
          "type": "boolean"
        },
        "output": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input",
        "output",
        "cacheRead",
        "live"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/AppServerMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
