{
  "$defs": {
    "Brief": {
      "properties": {
        "baseline": {
          "description": "Research: what the candidate is compared against, and how both are measured.",
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/BriefBudget"
        },
        "constraints": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "decisionRule": {
          "$ref": "#/$defs/DecisionRule",
          "description": "Research: the rule the verdict is computed from."
        },
        "doneWhen": {
          "description": "At least one.",
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "goal": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "metric": {
          "description": "Research: the one number the judge reports for baseline and candidate, e.g. \"p50 cold start in ms\".",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "pointers": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "why": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "goal",
        "why",
        "pointers",
        "constraints",
        "doneWhen"
      ],
      "type": "object"
    },
    "BriefBudget": {
      "properties": {
        "agentHours": {
          "description": "Older briefs only; a lead now gives `size`.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "size": {
          "$ref": "#/$defs/BudgetSize",
          "description": "How big a research spend the lead allows, relative like plan sizes; never a time guess."
        }
      },
      "type": "object"
    },
    "BudgetSize": {
      "description": "How big a research spend is, relative like plan sizes.",
      "enum": [
        "S",
        "M",
        "L"
      ],
      "type": "string"
    },
    "DecisionRule": {
      "description": "Applied to the improvement: candidate − baseline, negated when lower is better. GO when it is at least\n`goAtLeast`, STOP when it is below `stopBelow`, INCONCLUSIVE in between.",
      "properties": {
        "better": {
          "$ref": "#/$defs/DecisionRuleBetter"
        },
        "goAtLeast": {
          "type": "number"
        },
        "stopBelow": {
          "type": "number"
        }
      },
      "required": [
        "better",
        "goAtLeast",
        "stopBelow"
      ],
      "type": "object"
    },
    "DecisionRuleBetter": {
      "enum": [
        "higher",
        "lower"
      ],
      "type": "string"
    },
    "IntakeChannel": {
      "enum": [
        "app",
        "mcp",
        "lead"
      ],
      "type": "string"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "MetricValues": {
      "description": "The judge's reported numbers for the brief's metric.",
      "properties": {
        "baseline": {
          "type": "number"
        },
        "candidate": {
          "type": "number"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "type": "object"
    },
    "PlaybookRef": {
      "description": "<playbook name>@<full lowercase hex git blob SHA>",
      "pattern": "^(?:bugfix|feature|research)@(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "ResearchOutcome": {
      "description": "STOP is a success: the question was answered.",
      "enum": [
        "go",
        "stop",
        "inconclusive"
      ],
      "type": "string"
    },
    "ResearchVerdict": {
      "description": "Computed by the hub, never reported by an agent; `outcome` always follows from `rule` and `metricValues`.",
      "properties": {
        "computedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "metricValues": {
          "$ref": "#/$defs/MetricValues"
        },
        "outcome": {
          "$ref": "#/$defs/ResearchOutcome"
        },
        "rule": {
          "$ref": "#/$defs/DecisionRule",
          "description": "The brief's rule."
        }
      },
      "required": [
        "outcome",
        "metricValues",
        "rule",
        "computedAt"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "Workstream": {
      "properties": {
        "brief": {
          "$ref": "#/$defs/Brief",
          "description": "Absent while draft."
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "headline": {
          "maxLength": 280,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "headlineAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "outcome": {
          "$ref": "#/$defs/ResearchOutcome",
          "description": "Research workstreams, once the verdict is computed; set together with `verdict`. A STOP is done, not failed."
        },
        "playbook": {
          "$ref": "#/$defs/PlaybookRef",
          "description": "Pinned at creation; the brief validates against this version. Absent on workstreams from before M9."
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "source": {
          "$ref": "#/$defs/WorkstreamSource"
        },
        "state": {
          "$ref": "#/$defs/WorkstreamState"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "verdict": {
          "$ref": "#/$defs/ResearchVerdict"
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        }
      },
      "required": [
        "workstreamId",
        "projectRef",
        "title",
        "source",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "WorkstreamId": {
      "pattern": "^W[1-9][0-9]*$",
      "type": "string"
    },
    "WorkstreamSource": {
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "Who submitted it: an agent keyId, \"human\" or \"lead:<machineId>/<projectId>\".",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/IntakeChannel"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text",
        "channel",
        "by",
        "at"
      ],
      "type": "object"
    },
    "WorkstreamState": {
      "oneOf": [
        {
          "enum": [
            "draft",
            "running",
            "converging",
            "done",
            "stopped",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "verifying",
          "description": "Never set now that a lead closes its work; old records were moved back to running.",
          "type": "string"
        }
      ]
    }
  },
  "$ref": "#/$defs/Workstream",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
