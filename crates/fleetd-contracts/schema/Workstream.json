{
  "$defs": {
    "Brief": {
      "properties": {
        "constraints": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "doneWhen": {
          "description": "At least one.",
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "goal": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "pointers": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "why": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "goal",
        "why",
        "pointers",
        "constraints",
        "doneWhen"
      ],
      "type": "object"
    },
    "IntakeChannel": {
      "enum": [
        "app",
        "mcp",
        "lead"
      ],
      "type": "string"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "PlaybookRef": {
      "description": "<playbook name>@<full lowercase hex git blob SHA>",
      "pattern": "^(?:bugfix|feature|research)@(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "Workstream": {
      "properties": {
        "brief": {
          "$ref": "#/$defs/Brief",
          "description": "Absent while draft."
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "headline": {
          "maxLength": 280,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "headlineAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "playbook": {
          "$ref": "#/$defs/PlaybookRef",
          "description": "Pinned at creation. Absent on workstreams from before M9."
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "source": {
          "$ref": "#/$defs/WorkstreamSource"
        },
        "state": {
          "$ref": "#/$defs/WorkstreamState"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        }
      },
      "required": [
        "workstreamId",
        "projectRef",
        "title",
        "source",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "WorkstreamId": {
      "pattern": "^W[1-9][0-9]*$",
      "type": "string"
    },
    "WorkstreamSource": {
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "Who submitted it: an agent keyId, \"human\" or \"lead:<machineId>/<projectId>\".",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/IntakeChannel"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text",
        "channel",
        "by",
        "at"
      ],
      "type": "object"
    },
    "WorkstreamState": {
      "oneOf": [
        {
          "enum": [
            "draft",
            "running",
            "converging",
            "done",
            "stopped",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "verifying",
          "description": "Never set now that a lead closes its work; old records were moved back to running.",
          "type": "string"
        }
      ]
    }
  },
  "$ref": "#/$defs/Workstream",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
