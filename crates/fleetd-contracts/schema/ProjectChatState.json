{
  "$defs": {
    "ChatMessageId": {
      "pattern": "^m[1-9][0-9]*$",
      "type": "string"
    },
    "ChatOpenItem": {
      "description": "An inline item that waits on the human: which message, and what it asks for.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ChatOpenItemKind"
        },
        "messageId": {
          "$ref": "#/$defs/ChatMessageId"
        }
      },
      "required": [
        "messageId",
        "kind"
      ],
      "type": "object"
    },
    "ChatOpenItemKind": {
      "description": "`ChatItem`'s kind.",
      "enum": [
        "secret_request",
        "command_approval"
      ],
      "type": "string",
      "x-open": true
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "ProjectChatState": {
      "description": "One chat's state, for the sidebar and the status row.",
      "properties": {
        "lastMessageAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastSeq": {
          "description": "The newest message's `seq`; 0 for an empty chat.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "leadWorking": {
          "description": "The lead is mid-turn.",
          "type": "boolean"
        },
        "needsYou": {
          "description": "The lead's last message waits for a human reply, or an inline item is open.",
          "type": "boolean"
        },
        "openItems": {
          "description": "The inline items still open, oldest first, however far back: the chat may not have their page loaded. Absent\nwhen none is (and from older hubs).",
          "items": {
            "$ref": "#/$defs/ChatOpenItem"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        }
      },
      "required": [
        "projectRef",
        "needsYou",
        "leadWorking",
        "lastSeq"
      ],
      "type": "object"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "description": "A project: a workspace with a lead and its own directory, on its home machine, where the lead runs. Its\n`projectId` is the node's id for that directory, so the ref also addresses the files; the directory may be a git\nrepo or a plain folder. A project holds zero or more repos (`ProjectRepo`), each in a node directory of its\nown or in the project's.",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$ref": "#/$defs/ProjectChatState",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
