{
  "$defs": {
    "Brief": {
      "properties": {
        "constraints": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "doneWhen": {
          "description": "At least one.",
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "goal": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "pointers": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "why": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "goal",
        "why",
        "pointers",
        "constraints",
        "doneWhen"
      ],
      "type": "object"
    },
    "ChangeId": {
      "pattern": "^X[1-9][0-9]*$",
      "type": "string"
    },
    "GitHubRepo": {
      "description": "GitHub repository as owner/name",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]{1,100})$",
      "type": "string"
    },
    "IntakeChannel": {
      "enum": [
        "app",
        "mcp",
        "lead"
      ],
      "type": "string"
    },
    "Lead": {
      "properties": {
        "lastWakeAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "parked": {
          "$ref": "#/$defs/UsageParked",
          "description": "M4: the lead thread hit a usage limit; derived from the usage layer when read."
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "sessionGeneration": {
          "description": "Bumped by each `lead_start {fresh}`.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "$ref": "#/$defs/LeadState"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId",
          "description": "The current lead thread on the project's machine; earlier ones stay on the node as history."
        }
      },
      "required": [
        "projectRef",
        "threadId",
        "state",
        "startedAt",
        "sessionGeneration"
      ],
      "type": "object"
    },
    "LeadState": {
      "enum": [
        "starting",
        "idle",
        "working",
        "stalled",
        "stopped"
      ],
      "type": "string"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "PlanItemId": {
      "pattern": "^P[1-9][0-9]*$",
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectOutcome": {
      "description": "The one-call project outcome, returned as-is by project_get.",
      "properties": {
        "asOf": {
          "$ref": "#/$defs/Timestamp"
        },
        "lead": {
          "$ref": "#/$defs/Lead",
          "description": "Absent until lead_start."
        },
        "mediumAllowed": {
          "description": "Whether the lead may run a task on the medium profile (`project_set`); absent from older hubs, where it is on.",
          "type": "boolean"
        },
        "next": {
          "description": "Hint for the next call.",
          "type": "string"
        },
        "project": {
          "$ref": "#/$defs/ProjectSummary"
        },
        "stale": {
          "type": "boolean"
        },
        "taskCounts": {
          "$ref": "#/$defs/TaskCounts",
          "description": "Absent until the project has a task."
        },
        "tasks": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/Task"
          },
          "maxItems": 20,
          "type": "array"
        },
        "threads": {
          "description": "Newest activity first. Task threads are left out; they show under `tasks`.",
          "items": {
            "$ref": "#/$defs/ThreadSummary"
          },
          "maxItems": 20,
          "type": "array"
        },
        "trains": {
          "description": "The merge trains of the project's repos; absent until one of its PRs was enqueued.",
          "items": {
            "$ref": "#/$defs/TrainState"
          },
          "maxItems": 10,
          "type": "array"
        },
        "truncated": {
          "description": "True when `threads`, `workstreams` or `tasks` was trimmed to its limit.",
          "type": "boolean"
        },
        "workstreams": {
          "description": "Open workstreams (not done, stopped or failed), newest first.",
          "items": {
            "$ref": "#/$defs/Workstream"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "project",
        "threads",
        "stale",
        "asOf"
      ],
      "type": "object"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "ProjectSummary": {
      "properties": {
        "lastActivityAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "threads": {
          "$ref": "#/$defs/ThreadCounts"
        },
        "title": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        }
      },
      "required": [
        "machineId",
        "projectId",
        "title",
        "workspaceRoot",
        "threads",
        "lastActivityAt"
      ],
      "type": "object"
    },
    "RunEnd": {
      "description": "Why a run ended, so a node going away reads apart from a person stopping it. Set once the run is no longer active.",
      "oneOf": [
        {
          "const": "completed",
          "description": "claude finished the turn.",
          "type": "string"
        },
        {
          "const": "requested",
          "description": "Someone interrupted or stopped it: `RunInfo.endedBy` says who.",
          "type": "string"
        },
        {
          "const": "superseded",
          "description": "A steer cut it short at a tool boundary to take its own turn (`RunInfo.supersededBy`). Not a failure.",
          "type": "string"
        },
        {
          "const": "node_stopping",
          "description": "The node was stopping (SIGTERM) and cut it.",
          "type": "string"
        },
        {
          "const": "node_restarted",
          "description": "The node found it active on start: it died with the node process (crash, SIGKILL, power loss).",
          "type": "string"
        },
        {
          "const": "machine_slept",
          "description": "The machine slept and claude's stream did not come back.",
          "type": "string"
        },
        {
          "const": "exited",
          "description": "claude exited or was killed with nobody asking; `failure` has the exit code or signal.",
          "type": "string"
        },
        {
          "const": "limited",
          "description": "A usage, rate or pool limit; `failure.resetAt` says when to continue.",
          "type": "string"
        },
        {
          "const": "context_full",
          "description": "The conversation no longer fits in the model's context.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Any other failure; `failure.class` says which.",
          "type": "string"
        },
        {
          "const": "stalled",
          "description": "Set by the hub, never by a node: the watchdog saw no output for too long and ended the run.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "Task": {
      "properties": {
        "attempt": {
          "description": "1 for the first launch.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "branch": {
          "description": "`fleetd/<taskId>-<slug>`; write tasks only.",
          "minLength": 1,
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "endedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "itemId": {
          "$ref": "#/$defs/PlanItemId",
          "description": "The plan item it was spawned for (`--item`)."
        },
        "kind": {
          "$ref": "#/$defs/TaskKind"
        },
        "parked": {
          "$ref": "#/$defs/UsageParked",
          "description": "M4: its thread hit a usage limit; the task is idle until fleetd sends \"continue\" at `resumeAt`."
        },
        "pr": {
          "description": "The PR a review task reviews. Required at spawn for review; absent on older rows (hub-spawned judges).",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/TaskProfile",
          "default": "high",
          "description": "Resolved at spawn. Rows stored with a model and effort read as `high` (the hub migrates its own)."
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        "qa": {
          "description": "A review task spawned with `--qa`.",
          "type": "boolean"
        },
        "queuedReason": {
          "description": "Why it is queued, e.g. \"fleet cap: 40 of 40 running\".",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/TaskResult"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "state": {
          "$ref": "#/$defs/TaskState"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "threadRef": {
          "$ref": "#/$defs/ThreadRef"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "worktreePath": {
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "projectRef",
        "workstreamId",
        "title",
        "kind",
        "prompt",
        "state",
        "attempt",
        "createdAt"
      ],
      "type": "object"
    },
    "TaskCounts": {
      "description": "A project's tasks by state, all time.",
      "properties": {
        "cancelled": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "done": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "idle": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "queued": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "queued",
        "running",
        "idle",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "object"
    },
    "TaskId": {
      "pattern": "^T[1-9][0-9]*$",
      "type": "string"
    },
    "TaskKind": {
      "description": "Only write tasks get a worktree.",
      "enum": [
        "write",
        "read",
        "review"
      ],
      "type": "string"
    },
    "TaskProfile": {
      "description": "What an agent runs on. There are exactly two, both claude-opus-5-5: `high` (effort high) is the default and what\nthe lead, every reviewer and every helper call run; `medium` (effort medium) is for mechanical tasks the lead picks.",
      "enum": [
        "high",
        "medium"
      ],
      "type": "string"
    },
    "TaskResult": {
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "branch": {
          "minLength": 1,
          "type": "string"
        },
        "endCause": {
          "$ref": "#/$defs/RunEnd",
          "description": "Why its last run ended (the node stopped, claude exited, a limit, context full, …); absent on results an\nolder hub recorded, and when it never ran."
        },
        "prUrl": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskResultStatus"
        },
        "tail": {
          "description": "The latest assistant message, trimmed to its last 2000 characters.",
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "status",
        "tail",
        "at"
      ],
      "type": "object"
    },
    "TaskResultStatus": {
      "enum": [
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "TaskState": {
      "enum": [
        "queued",
        "running",
        "idle",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "ThreadCounts": {
      "properties": {
        "failed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "idle": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "waiting": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "running",
        "waiting",
        "idle",
        "failed"
      ],
      "type": "object"
    },
    "ThreadError": {
      "properties": {
        "class": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "class",
        "message"
      ],
      "type": "object"
    },
    "ThreadId": {
      "type": "string"
    },
    "ThreadRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        }
      },
      "required": [
        "machineId",
        "threadId"
      ],
      "type": "object"
    },
    "ThreadStatus": {
      "enum": [
        "running",
        "waiting",
        "idle",
        "completed",
        "failed",
        "interrupted",
        "cancelled"
      ],
      "type": "string"
    },
    "ThreadSummary": {
      "properties": {
        "asOf": {
          "$ref": "#/$defs/Timestamp"
        },
        "effort": {
          "description": "As reported by the runner; not narrowed to Effort because it may report other levels.",
          "type": "string"
        },
        "endCause": {
          "$ref": "#/$defs/RunEnd",
          "description": "Why its latest run ended; absent while it runs and from older nodes."
        },
        "headline": {
          "description": "First line of the latest visible assistant text.",
          "maxLength": 280,
          "type": "string"
        },
        "lastError": {
          "$ref": "#/$defs/ThreadError"
        },
        "lastProgressAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "latestMessageTail": {
          "maxLength": 4096,
          "type": "string"
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "model": {
          "type": "string"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "stale": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "title": {
          "type": "string"
        },
        "usageLimitResetAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "machineId",
        "threadId",
        "projectId",
        "title",
        "status",
        "headline",
        "latestMessageTail",
        "lastProgressAt",
        "stale",
        "asOf"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "TrainState": {
      "description": "One serial train per repo.",
      "properties": {
        "head": {
          "$ref": "#/$defs/ChangeId",
          "description": "The Change being rebased, checked or merged now."
        },
        "queue": {
          "description": "Waiting Changes in train order.",
          "items": {
            "$ref": "#/$defs/ChangeId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "repo": {
          "$ref": "#/$defs/GitHubRepo"
        }
      },
      "required": [
        "repo",
        "queue"
      ],
      "type": "object"
    },
    "UsageClass": {
      "description": "What stopped a turn. `usage_limit`: the plan's usage limit or a proxy cooldown, with a reset. `rate_limit`: a 429.\n`pool_exhausted`: the user's proxy has no account for the model; it waits for usage_resume.",
      "enum": [
        "usage_limit",
        "rate_limit",
        "pool_exhausted"
      ],
      "type": "string"
    },
    "UsageParked": {
      "description": "A task or lead whose thread hit a limit; fleetd sends it one \"continue\" at `resume_at`.",
      "properties": {
        "class": {
          "$ref": "#/$defs/UsageClass"
        },
        "resumeAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "Absent for pool_exhausted: it resumes on usage_resume."
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "class",
        "since"
      ],
      "type": "object"
    },
    "Workstream": {
      "properties": {
        "brief": {
          "$ref": "#/$defs/Brief",
          "description": "Absent while draft."
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "headline": {
          "maxLength": 280,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "headlineAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "source": {
          "$ref": "#/$defs/WorkstreamSource"
        },
        "state": {
          "$ref": "#/$defs/WorkstreamState"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        }
      },
      "required": [
        "workstreamId",
        "projectRef",
        "title",
        "source",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "WorkstreamId": {
      "pattern": "^W[1-9][0-9]*$",
      "type": "string"
    },
    "WorkstreamSource": {
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "Who submitted it: an agent keyId, \"human\" or \"lead:<machineId>/<projectId>\".",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/IntakeChannel"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text",
        "channel",
        "by",
        "at"
      ],
      "type": "object"
    },
    "WorkstreamState": {
      "oneOf": [
        {
          "enum": [
            "done",
            "stopped"
          ],
          "type": "string"
        },
        {
          "const": "open",
          "description": "A draft (no brief yet) or running: which one is the brief's to say. Older records read back as open.",
          "type": "string"
        }
      ]
    }
  },
  "$ref": "#/$defs/ProjectOutcome",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
