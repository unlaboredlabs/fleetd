{
  "$defs": {
    "AgentBlock": {
      "description": "An agent at work: the client fills in its live state. Exactly one of `taskId` and `threadRef`.",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "threadRef": {
          "$ref": "#/$defs/ThreadRef"
        }
      },
      "type": "object"
    },
    "AskBlock": {
      "description": "A question for the human, as buttons: Approve and Deny without `options`, one of `options` with them. The\nanswer is the human's chat reply (`chat_send` with the button's label as its text), so only the human answers\nit; an agent's message never does. A command that needs approval still goes through `gated_run`.",
      "properties": {
        "options": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 2,
          "type": "array"
        },
        "question": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    },
    "AttachmentBlock": {
      "description": "An image or clip already uploaded to the hub: its bytes come from `attachment_get`.",
      "properties": {
        "attachmentId": {
          "$ref": "#/$defs/AttachmentId"
        },
        "caption": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "attachmentId"
      ],
      "type": "object"
    },
    "AttachmentId": {
      "pattern": "^F[1-9][0-9]*$",
      "type": "string"
    },
    "AttachmentMime": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "text/plain",
        "application/pdf"
      ],
      "type": "string"
    },
    "AttachmentRef": {
      "description": "A file on a message: what the app shows without fetching it. Its bytes come from `attachment_get`.",
      "properties": {
        "attachmentId": {
          "$ref": "#/$defs/AttachmentId"
        },
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mime": {
          "$ref": "#/$defs/AttachmentMime"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "attachmentId",
        "name",
        "mime",
        "bytes"
      ],
      "type": "object"
    },
    "ChartBlock": {
      "description": "A line, bar or area chart: `x` labels along the bottom, one value per label in each series.",
      "properties": {
        "chart": {
          "$ref": "#/$defs/ChartType"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "unit": {
          "description": "The values' unit, e.g. \"min\", \"%\", \"PRs\".",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "x": {
          "items": {
            "maxLength": 40,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "chart",
        "title",
        "x",
        "series"
      ],
      "type": "object"
    },
    "ChartSeries": {
      "properties": {
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "values": {
          "description": "One per `x` label, in order.",
          "items": {
            "type": "number"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "type": "object"
    },
    "ChartType": {
      "enum": [
        "line",
        "bar",
        "area"
      ],
      "type": "string"
    },
    "ChatAuthor": {
      "oneOf": [
        {
          "enum": [
            "human",
            "lead"
          ],
          "type": "string"
        },
        {
          "const": "agent",
          "description": "An agent or integration writing with its own key (`fleetd chat` with an agent key): input for the lead, never\nthe human. It approves nothing, answers nothing that is the human's, and leaves needs-you as it was.",
          "type": "string"
        },
        {
          "const": "system",
          "description": "fleetd itself: one-line events (a PR merged, an agent started, a past order's state).",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatBlock": {
      "description": "One block: `v`, the block schema's version (`BLOCK_VERSION`), and its kind's fields. A kind or version a client\ndoesn't know shows as the part's text.",
      "oneOf": [
        {
          "$ref": "#/$defs/ChartBlock",
          "properties": {
            "kind": {
              "const": "chart",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TableBlock",
          "properties": {
            "kind": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DiffBlock",
          "properties": {
            "kind": {
              "const": "diff",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PrBlock",
          "properties": {
            "kind": {
              "const": "pr",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AgentBlock",
          "properties": {
            "kind": {
              "const": "agent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ChecklistBlock",
          "properties": {
            "kind": {
              "const": "checklist",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AttachmentBlock",
          "properties": {
            "kind": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AttachmentBlock",
          "properties": {
            "kind": {
              "const": "clip",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AskBlock",
          "properties": {
            "kind": {
              "const": "ask",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "v": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "v"
      ],
      "type": "object"
    },
    "ChatClient": {
      "description": "Where a human message was written.",
      "oneOf": [
        {
          "const": "app",
          "description": "The desktop app.",
          "type": "string"
        },
        {
          "const": "cli",
          "description": "`fleetd chat`.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatDelivery": {
      "description": "How a human message reached the lead.",
      "oneOf": [
        {
          "const": "turn",
          "description": "The lead was idle: the message started its next turn.",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "The lead was mid-turn: it takes the message at its next step, as a steer.",
          "type": "string"
        },
        {
          "const": "now",
          "description": "The lead was mid-turn and the human asked for now: its running step stopped for the message.",
          "type": "string"
        },
        {
          "const": "queued",
          "description": "The lead is starting, or its machine is away: the message waits and goes in as soon as it can.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatHistorySource": {
      "description": "Where a history message came from, for messages from before the chat existed (a read model; nothing is moved or\ndestroyed). Absent on messages written in the chat.",
      "oneOf": [
        {
          "const": "order",
          "description": "An order's text as it was submitted.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "A person's note on an order.",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "A person's steer to the lead or one of its agents.",
          "type": "string"
        },
        {
          "const": "lead_message",
          "description": "What the lead said in its own session.",
          "type": "string"
        },
        {
          "const": "order_outcome",
          "description": "An order's outcome (done, stopped, failed) as a one-line event.",
          "type": "string"
        },
        {
          "const": "question",
          "description": "A question the lead asked with the retired questions tool, and its answer.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatItem": {
      "description": "The two things a chat can't carry as plain text, shown inline in place of the message text.",
      "oneOf": [
        {
          "$ref": "#/$defs/SecretRequestItem",
          "properties": {
            "kind": {
              "const": "secret_request",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/CommandApprovalItem",
          "properties": {
            "kind": {
              "const": "command_approval",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ChatMessage": {
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "maxItems": 8,
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/ChatAuthor"
        },
        "by": {
          "description": "The name of the key that wrote it: a person's device for a human message, the agent for an agent's.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "client": {
          "$ref": "#/$defs/ChatClient",
          "description": "A human message: where it was written."
        },
        "clientRequestId": {
          "description": "A human message: the `clientRequestId` its `chat_send` carried, for the app's optimistic copy.",
          "minLength": 1,
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "delivery": {
          "$ref": "#/$defs/ChatDelivery",
          "description": "A human message: how it reached the lead."
        },
        "history": {
          "$ref": "#/$defs/ChatHistorySource",
          "description": "From before the chat: where this history message came from."
        },
        "item": {
          "$ref": "#/$defs/ChatItem"
        },
        "messageId": {
          "$ref": "#/$defs/ChatMessageId"
        },
        "parts": {
          "description": "A final lead message of more than one bubble, or with a block: its bubbles in order. Absent: `text` is one\nbubble (and while a message streams).",
          "items": {
            "$ref": "#/$defs/ChatPart"
          },
          "maxItems": 24,
          "minItems": 1,
          "type": "array"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/ChatMessageState"
        },
        "text": {
          "description": "Markdown. Empty while a streamed message has no text yet, and for an inline `item`.",
          "maxLength": 100000,
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "Set when the text was last appended to, or an item's state changed."
        }
      },
      "required": [
        "messageId",
        "projectRef",
        "seq",
        "author",
        "text",
        "createdAt",
        "state"
      ],
      "type": "object"
    },
    "ChatMessageId": {
      "pattern": "^m[1-9][0-9]*$",
      "type": "string"
    },
    "ChatMessageState": {
      "oneOf": [
        {
          "enum": [
            "final"
          ],
          "type": "string"
        },
        {
          "const": "streaming",
          "description": "The lead is still writing it: `chat_delta` frames append to its text until it is `final`.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatPart": {
      "description": "One bubble of a lead message: `text.slice(start, end)` (UTF-16 offsets, like `ChatDelta.offset`), shown as\nmarkdown, or as `block` when it has one (the slice is then the block's fence, its readable fallback).",
      "properties": {
        "block": {
          "$ref": "#/$defs/ChatBlock"
        },
        "end": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "ChatRequestId": {
      "pattern": "^Q[1-9][0-9]*$",
      "type": "string"
    },
    "ChecklistBlock": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "ChecklistItem": {
      "properties": {
        "done": {
          "type": "boolean"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "text",
        "done"
      ],
      "type": "object"
    },
    "CommandApprovalItem": {
      "description": "A risky command (prod write, spend, delete, credential use) or a session's permission prompt waits for the\nhuman: the exact command, then Approve or Deny. Answered with `approval_answer`, naming `requestId`. Exactly one of\n`gated` and `permission`.",
      "properties": {
        "answeredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "The key name of the person who answered.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "exitCode": {
          "format": "int64",
          "type": "integer"
        },
        "finishedAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "Once it ran or failed: when the result came back."
        },
        "gated": {
          "$ref": "#/$defs/GatedRunSpec",
          "description": "A gated command: exactly what runs once approved."
        },
        "machineId": {
          "$ref": "#/$defs/MachineId",
          "description": "Where it runs, or the machine of the session that asks."
        },
        "note": {
          "description": "Why it is open again (\"not run: the node was offline when approved\"), or why it failed without running.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "outputTail": {
          "description": "The end of the output, once it ran.",
          "maxLength": 2000,
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/ToolPermission",
          "description": "A session's permission prompt: the tool and what it would do."
        },
        "requestId": {
          "$ref": "#/$defs/ChatRequestId"
        },
        "state": {
          "$ref": "#/$defs/CommandApprovalState"
        }
      },
      "required": [
        "requestId",
        "machineId",
        "state"
      ],
      "type": "object"
    },
    "CommandApprovalState": {
      "oneOf": [
        {
          "enum": [
            "open",
            "approved",
            "denied"
          ],
          "type": "string"
        },
        {
          "const": "ran",
          "description": "Approved and run: see `exitCode` and `outputTail`.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Approved, and the node could not run it.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "DecisionKey": {
      "description": "Lowercase dotted slug, [a-z0-9]+(.[a-z0-9_-]+)*, at most 80",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)*$",
      "type": "string"
    },
    "DiffBlock": {
      "description": "Changes to show: the files with their hunks, or a PR whose diff the client reads. Exactly one of the two.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/DiffFile"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "pr": {
          "$ref": "#/$defs/PrBlock"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DiffFile": {
      "properties": {
        "hunks": {
          "description": "Unified-diff hunks, each from its `@@` line.",
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "hunks"
      ],
      "type": "object"
    },
    "EnvName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
      "type": "string"
    },
    "GatedClass": {
      "enum": [
        "irreversible",
        "money",
        "credential"
      ],
      "type": "string"
    },
    "GatedRunSpec": {
      "description": "Stored with the approval and never changed: the human approves exactly these bytes.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/GatedClass"
        },
        "cwd": {
          "pattern": "^/",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "secretEnv": {
          "items": {
            "$ref": "#/$defs/SecretEnvEntry"
          },
          "maxItems": 20,
          "type": "array"
        },
        "timeoutSec": {
          "maximum": 1800,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "argv",
        "class",
        "reason",
        "timeoutSec"
      ],
      "type": "object"
    },
    "GitHubRepo": {
      "description": "GitHub repository as owner/name",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]{1,100})$",
      "type": "string"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "PrBlock": {
      "description": "A pull request: the client fills in its live state (title, checks, review, merged) from the hub.",
      "properties": {
        "number": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "repo": {
          "$ref": "#/$defs/GitHubRepo"
        },
        "title": {
          "description": "Shown until the live title is known.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "type": "object"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "SecretEnvEntry": {
      "properties": {
        "name": {
          "$ref": "#/$defs/EnvName"
        },
        "secretKey": {
          "$ref": "#/$defs/DecisionKey"
        }
      },
      "required": [
        "name",
        "secretKey"
      ],
      "type": "object"
    },
    "SecretFingerprint": {
      "description": "8 lowercase hex characters: the sha256 prefix of the plaintext",
      "pattern": "^[0-9a-f]{8}$",
      "type": "string"
    },
    "SecretRequestItem": {
      "description": "The lead needs a secret. The app shows a masked field; the value never enters the transcript: it is sealed to the\nsink's machine and answered with `secret_submit`, naming `requestId`. Only its fingerprint comes back.",
      "properties": {
        "answeredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "The key name of the person who answered.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "envName": {
          "$ref": "#/$defs/EnvName",
          "description": "An `env:` sink: the variable it writes, when not the one `name` gives (`secrets::secret_env_name`)."
        },
        "fingerprint": {
          "$ref": "#/$defs/SecretFingerprint",
          "description": "Once stored."
        },
        "name": {
          "description": "The secret's key, e.g. `stripe.test_key`.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "note": {
          "description": "Why it is open again, or why it could not be stored.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "requestId": {
          "$ref": "#/$defs/ChatRequestId"
        },
        "sink": {
          "$ref": "#/$defs/SecretSink"
        },
        "state": {
          "$ref": "#/$defs/SecretRequestState"
        },
        "text": {
          "description": "One line: why the lead needs it.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "name",
        "text",
        "sink",
        "state"
      ],
      "type": "object"
    },
    "SecretRequestState": {
      "enum": [
        "open",
        "stored",
        "withdrawn"
      ],
      "type": "string",
      "x-open": true
    },
    "SecretSink": {
      "type": "string"
    },
    "TableBlock": {
      "description": "Rows of plain-text cells, one per column.",
      "properties": {
        "columns": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 100,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "TaskId": {
      "pattern": "^T[1-9][0-9]*$",
      "type": "string"
    },
    "ThreadId": {
      "type": "string"
    },
    "ThreadRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        }
      },
      "required": [
        "machineId",
        "threadId"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "ToolPermission": {
      "description": "An approval raised by a session's tool permission prompt instead of a gated command: answering it answers the prompt\non the project's node. Its machine is the request's project's.",
      "properties": {
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "description": "The command, the path, or the tool's own description.",
          "maxLength": 2000,
          "type": "string"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "toolName": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "requestId",
        "toolName",
        "summary"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/ChatMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
