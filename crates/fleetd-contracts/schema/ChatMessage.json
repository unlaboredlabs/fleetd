{
  "$defs": {
    "AgentBlock": {
      "description": "An agent at work: the client fills in its live state. Exactly one of `taskId` and `threadRef`.",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "threadRef": {
          "$ref": "#/$defs/ThreadRef"
        }
      },
      "type": "object"
    },
    "AskBlock": {
      "description": "A question for the human, as buttons: Approve and Deny without `options`, one of `options` with them. The\nanswer is the human's chat reply (`chat_send` with the button's label as its text), so only the human answers\nit; an agent's message never does. A command that needs approval still goes through `gated_run`.",
      "properties": {
        "options": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 2,
          "type": "array"
        },
        "question": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "type": "object"
    },
    "AttachmentBlock": {
      "description": "An image or clip already uploaded to the hub: its bytes come from `attachment_get`.",
      "properties": {
        "attachmentId": {
          "$ref": "#/$defs/AttachmentId"
        },
        "caption": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "attachmentId"
      ],
      "type": "object"
    },
    "AttachmentId": {
      "pattern": "^F[1-9][0-9]*$",
      "type": "string"
    },
    "AttachmentMime": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "text/plain",
        "application/pdf"
      ],
      "type": "string"
    },
    "AttachmentRef": {
      "description": "A file on a message: what the app shows without fetching it. Its bytes come from `attachment_get`.",
      "properties": {
        "attachmentId": {
          "$ref": "#/$defs/AttachmentId"
        },
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "mime": {
          "$ref": "#/$defs/AttachmentMime"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "attachmentId",
        "name",
        "mime",
        "bytes"
      ],
      "type": "object"
    },
    "ChartBlock": {
      "description": "A line, bar or area chart: `x` labels along the bottom, one value per label in each series.",
      "properties": {
        "chart": {
          "$ref": "#/$defs/ChartType"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "unit": {
          "description": "The values' unit, e.g. \"min\", \"%\", \"PRs\".",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "x": {
          "items": {
            "maxLength": 40,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "chart",
        "title",
        "x",
        "series"
      ],
      "type": "object"
    },
    "ChartSeries": {
      "properties": {
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "values": {
          "description": "One per `x` label, in order.",
          "items": {
            "type": "number"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "type": "object"
    },
    "ChartType": {
      "enum": [
        "line",
        "bar",
        "area"
      ],
      "type": "string"
    },
    "ChatAuthor": {
      "oneOf": [
        {
          "enum": [
            "human",
            "lead"
          ],
          "type": "string"
        },
        {
          "const": "agent",
          "description": "An agent or integration writing with its own key (`fleetd chat` with an agent key): input for the lead, never\nthe human. It approves nothing, answers nothing that is the human's, and leaves needs-you as it was.",
          "type": "string"
        },
        {
          "const": "system",
          "description": "fleetd itself: one-line events (a PR merged, an agent started, a past order's state).",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatBlock": {
      "description": "One block: `v`, the block schema's version (`BLOCK_VERSION`), and its kind's fields. A kind or version a client\ndoesn't know shows as the part's text.",
      "oneOf": [
        {
          "$ref": "#/$defs/ChartBlock",
          "properties": {
            "kind": {
              "const": "chart",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/TableBlock",
          "properties": {
            "kind": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DiffBlock",
          "properties": {
            "kind": {
              "const": "diff",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PrBlock",
          "properties": {
            "kind": {
              "const": "pr",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AgentBlock",
          "properties": {
            "kind": {
              "const": "agent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ChecklistBlock",
          "properties": {
            "kind": {
              "const": "checklist",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AttachmentBlock",
          "properties": {
            "kind": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AttachmentBlock",
          "properties": {
            "kind": {
              "const": "clip",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/AskBlock",
          "properties": {
            "kind": {
              "const": "ask",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "v": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "v"
      ],
      "type": "object"
    },
    "ChatClient": {
      "description": "Where a human message was written.",
      "oneOf": [
        {
          "const": "app",
          "description": "The desktop app.",
          "type": "string"
        },
        {
          "const": "cli",
          "description": "`fleetd chat`.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatDelivery": {
      "description": "How a human message reached the lead.",
      "oneOf": [
        {
          "const": "turn",
          "description": "The lead was idle: the message started its next turn.",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "The lead was mid-turn: it takes the message at its next step, as a steer.",
          "type": "string"
        },
        {
          "const": "now",
          "description": "The lead was mid-turn and the human asked for now: its running step stopped for the message.",
          "type": "string"
        },
        {
          "const": "queued",
          "description": "The lead is starting, or its machine is away: the message waits and goes in as soon as it can.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatHistorySource": {
      "description": "Where a history message came from, for messages from before the chat existed (a read model; nothing is moved or\ndestroyed). Absent on messages written in the chat.",
      "oneOf": [
        {
          "const": "order",
          "description": "An order's text as it was submitted.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "A person's note on an order.",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "A person's steer to the lead or one of its agents.",
          "type": "string"
        },
        {
          "const": "lead_message",
          "description": "What the lead said in its own session.",
          "type": "string"
        },
        {
          "const": "order_outcome",
          "description": "An order's outcome (done, stopped, failed) as a one-line event.",
          "type": "string"
        },
        {
          "const": "question",
          "description": "A question the lead asked with the retired questions tool, and its answer.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatItem": {
      "description": "The two things a chat can't carry as plain text, shown inline in place of the message text.",
      "oneOf": [
        {
          "$ref": "#/$defs/SecretRequestItem",
          "properties": {
            "kind": {
              "const": "secret_request",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/CommandApprovalItem",
          "properties": {
            "kind": {
              "const": "command_approval",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ChatMessage": {
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "maxItems": 20,
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/ChatAuthor"
        },
        "by": {
          "description": "The name of the key that wrote it: a person's device for a human message, the agent for an agent's.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "client": {
          "$ref": "#/$defs/ChatClient",
          "description": "A human message: where it was written."
        },
        "clientRequestId": {
          "description": "A human message: the `clientRequestId` its `chat_send` carried, for the app's optimistic copy.",
          "minLength": 1,
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "delivery": {
          "$ref": "#/$defs/ChatDelivery",
          "description": "A human message: how it reached the lead."
        },
        "history": {
          "$ref": "#/$defs/ChatHistorySource",
          "description": "From before the chat: where this history message came from."
        },
        "item": {
          "$ref": "#/$defs/ChatItem"
        },
        "memoryRefreshed": {
          "$ref": "#/$defs/MemoryRefreshed",
          "description": "A system line \"Memory refreshed: +a ~b −c\": what the nightly memory refresh changed, each change undone on its\nown or all together with `memory_undo`."
        },
        "messageId": {
          "$ref": "#/$defs/ChatMessageId"
        },
        "parts": {
          "description": "A final lead message of more than one bubble, or with a block: its bubbles in order. Absent: `text` is one\nbubble (and while a message streams).",
          "items": {
            "$ref": "#/$defs/ChatPart"
          },
          "maxItems": 24,
          "minItems": 1,
          "type": "array"
        },
        "person": {
          "$ref": "#/$defs/PersonRef",
          "description": "A human message: the person who wrote it. Absent from a hub before people."
        },
        "previewSuggestion": {
          "$ref": "#/$defs/PreviewSuggestion",
          "description": "An agent's suggestion to try a PR (preview_suggest), posted once per PR with `text` in its words: the app\nshows it as one line with Try it. Nothing runs from it."
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "remembered": {
          "$ref": "#/$defs/RememberedItem",
          "description": "A system line \"Remembered: …\" or \"Forgot: …\": what the lead's `remember` or `forget` wrote, which `memory_undo` takes back."
        },
        "replyTo": {
          "$ref": "#/$defs/ChatReplyTo",
          "description": "A human message: the bubble it answers."
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "skills": {
          "description": "A human message: the skills it named with `$name`, which the lead's copy lists.",
          "items": {
            "$ref": "#/$defs/SkillName"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "$ref": "#/$defs/ChatMessageState"
        },
        "text": {
          "description": "Markdown. Empty while a streamed message has no text yet, and for an inline `item`.",
          "maxLength": 100000,
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "Set when the text was last appended to, or an item's state changed."
        }
      },
      "required": [
        "messageId",
        "projectRef",
        "seq",
        "author",
        "text",
        "createdAt",
        "state"
      ],
      "type": "object"
    },
    "ChatMessageId": {
      "pattern": "^m[1-9][0-9]*$",
      "type": "string"
    },
    "ChatMessageState": {
      "oneOf": [
        {
          "enum": [
            "final"
          ],
          "type": "string"
        },
        {
          "const": "streaming",
          "description": "The lead is still writing it: `chat_delta` frames append to its text until it is `final`.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "ChatPart": {
      "description": "One bubble of a lead message: `text.slice(start, end)` (UTF-16 offsets, like `ChatDelta.offset`), shown as\nmarkdown, or as `block` when it has one (the slice is then the block's fence, its readable fallback).",
      "properties": {
        "block": {
          "$ref": "#/$defs/ChatBlock"
        },
        "end": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "ChatReplyTo": {
      "description": "The bubble a human message answers: a lead message and the bubble's place in it, as `parts` counts (0 for a\nmessage of one bubble). The lead reads that bubble whole over the reply, and when it was written.",
      "properties": {
        "messageId": {
          "$ref": "#/$defs/ChatMessageId"
        },
        "part": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "messageId",
        "part"
      ],
      "type": "object"
    },
    "ChatRequestId": {
      "pattern": "^Q[1-9][0-9]*$",
      "type": "string"
    },
    "ChecklistBlock": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "ChecklistItem": {
      "properties": {
        "done": {
          "type": "boolean"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "text",
        "done"
      ],
      "type": "object"
    },
    "CommandApprovalItem": {
      "description": "A risky command (prod write, spend, delete, credential use), a session's permission prompt or an agent's proposed\npreview setting waits for the human: exactly what it would do, then Approve or Deny. Answered with\n`approval_answer`, naming `requestId`. Exactly one of `gated`, `permission` and `previewConfig`.",
      "properties": {
        "answeredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "The key name of the person who answered.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "exitCode": {
          "format": "int64",
          "type": "integer"
        },
        "finishedAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "Once it ran or failed: when the result came back."
        },
        "gated": {
          "$ref": "#/$defs/GatedRunSpec",
          "description": "A gated command: exactly what runs once approved."
        },
        "machineId": {
          "$ref": "#/$defs/MachineId",
          "description": "Where it runs, or the machine of the session that asks."
        },
        "note": {
          "description": "Why it is open again (\"not run: the node was offline when approved\"), or why it failed without running.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "outputTail": {
          "description": "The end of the output, once it ran.",
          "maxLength": 2000,
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/ToolPermission",
          "description": "A session's permission prompt: the tool and what it would do."
        },
        "previewConfig": {
          "$ref": "#/$defs/PreviewConfigProposeCall",
          "description": "An agent's proposed preview setting (preview_config_propose): approved, it becomes the project's `preview`.\nOlder apps show it as an approval with neither command nor permission.\nBoxed: the setting is large beside the item's other fields, and every chat item would carry its size."
        },
        "requestId": {
          "$ref": "#/$defs/ChatRequestId"
        },
        "state": {
          "$ref": "#/$defs/CommandApprovalState"
        }
      },
      "required": [
        "requestId",
        "machineId",
        "state"
      ],
      "type": "object"
    },
    "CommandApprovalState": {
      "oneOf": [
        {
          "enum": [
            "open",
            "approved",
            "denied"
          ],
          "type": "string"
        },
        {
          "const": "ran",
          "description": "Approved and run: see `exitCode` and `outputTail`.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Approved, and the node could not run it.",
          "type": "string"
        }
      ],
      "x-open": true
    },
    "DecisionKey": {
      "description": "Lowercase dotted slug, [a-z0-9]+(.[a-z0-9_-]+)*, at most 80",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)*$",
      "type": "string"
    },
    "DiffBlock": {
      "description": "Changes to show: the files with their hunks, or a PR whose diff the client reads. Exactly one of the two.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/DiffFile"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "pr": {
          "$ref": "#/$defs/PrBlock"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DiffFile": {
      "properties": {
        "hunks": {
          "description": "Unified-diff hunks, each from its `@@` line.",
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "hunks"
      ],
      "type": "object"
    },
    "EnvName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
      "type": "string"
    },
    "GatedClass": {
      "enum": [
        "irreversible",
        "money",
        "credential"
      ],
      "type": "string"
    },
    "GatedRunSpec": {
      "description": "Stored with the approval and never changed: the human approves exactly these bytes.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/GatedClass"
        },
        "cwd": {
          "pattern": "^/",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "secretEnv": {
          "items": {
            "$ref": "#/$defs/SecretEnvEntry"
          },
          "maxItems": 20,
          "type": "array"
        },
        "timeoutSec": {
          "maximum": 14400,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "argv",
        "class",
        "reason",
        "timeoutSec"
      ],
      "type": "object"
    },
    "GitHubRepo": {
      "description": "GitHub repository as owner/name",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,38})/([A-Za-z0-9._-]{1,100})$",
      "type": "string"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "MemoryRefreshed": {
      "description": "What a nightly memory refresh changed, as one line in the project's chat: each change with its own Undo, and Undo\nall. Posted only when something changed.",
      "properties": {
        "items": {
          "description": "In the order the refresh made them.",
          "items": {
            "$ref": "#/$defs/RememberedItem"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "MemoryScope": {
      "oneOf": [
        {
          "const": "user",
          "description": "`user.md`: how the human works across every project.",
          "type": "string"
        },
        {
          "const": "project",
          "description": "This project's `MEMORY.md`, or one of its topic files.",
          "type": "string"
        }
      ]
    },
    "MemoryTopic": {
      "description": "Lowercase slug, [a-z0-9][a-z0-9-]{0,47}, other than memory",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
      "type": "string"
    },
    "PersonId": {
      "pattern": "^p_[a-z2-7]{8}$",
      "type": "string"
    },
    "PersonRef": {
      "description": "Who did something, with their name at the time: on chat messages, approvals, secrets, decisions and checklist\nchanges.",
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "personId": {
          "$ref": "#/$defs/PersonId"
        }
      },
      "required": [
        "personId",
        "name"
      ],
      "type": "object"
    },
    "PrBlock": {
      "description": "A pull request: the client fills in its live state (title, checks, review, merged) from the hub.",
      "properties": {
        "number": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "repo": {
          "$ref": "#/$defs/GitHubRepo"
        },
        "title": {
          "description": "Shown until the live title is known.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "type": "object"
    },
    "PreviewConfig": {
      "description": "A project's preview setting (Settings › Projects › Try it, or `project_settings_set {preview}`). Nothing runs\nbecause of it: it says how to run a preview someone asks for.",
      "properties": {
        "idleMinutes": {
          "default": 30,
          "description": "A preview no one used for this many minutes ends.",
          "maximum": 240,
          "minimum": 5,
          "type": "integer"
        },
        "web": {
          "$ref": "#/$defs/WebPreview"
        }
      },
      "type": "object"
    },
    "PreviewConfigProposeCall": {
      "description": "`preview_config_propose`: how to run the project's preview, for the person to approve as a card in the chat.\nNothing is saved until they do. Answered with the request, as `gated_run` is.",
      "properties": {
        "config": {
          "$ref": "#/$defs/PreviewConfig"
        },
        "why": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "config",
        "why"
      ],
      "type": "object"
    },
    "PreviewOf": {
      "description": "What a preview is of: one PR, or an order's PRs merged together onto their base on a scratch branch (D162).",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "pr",
              "type": "string"
            },
            "number": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "repo": {
              "$ref": "#/$defs/GitHubRepo"
            }
          },
          "required": [
            "kind",
            "repo",
            "number"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "order",
              "type": "string"
            },
            "workstreamId": {
              "$ref": "#/$defs/WorkstreamId"
            }
          },
          "required": [
            "kind",
            "workstreamId"
          ],
          "type": "object"
        }
      ]
    },
    "PreviewSuggestion": {
      "description": "An agent's suggestion to try a PR: one line with a Try it button, once per PR. Nothing runs from it.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "Who suggests it: \"#14's writer\".",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "of": {
          "$ref": "#/$defs/PreviewOf"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "why": {
          "description": "Why a person should try it, in a line.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "projectRef",
        "of",
        "by",
        "why",
        "at"
      ],
      "type": "object"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "description": "A project: a workspace with a lead and its own directory, on its home machine, where the lead runs. Its\n`projectId` is the node's id for that directory, so the ref also addresses the files; the directory may be a git\nrepo or a plain folder. A project holds zero or more repos (`ProjectRepo`), each in a node directory of its\nown or in the project's.",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "ReadyPath": {
      "type": "string"
    },
    "RememberedItem": {
      "description": "What a `remember` or `forget` call wrote, as a line in the project's chat. Undone with `memory_undo`.",
      "properties": {
        "forgotten": {
          "description": "`forget` removed `text`; Undo puts it back.",
          "type": "boolean"
        },
        "reason": {
          "description": "Why it was forgotten.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "replaced": {
          "description": "The whole entry it replaced, which Undo puts back.",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "text": {
          "description": "The entry written; with `forgotten`, the whole entry removed.",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/MemoryTopic"
        },
        "undone": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "text"
      ],
      "type": "object"
    },
    "SecretEnvEntry": {
      "properties": {
        "name": {
          "$ref": "#/$defs/EnvName"
        },
        "secretKey": {
          "$ref": "#/$defs/DecisionKey"
        }
      },
      "required": [
        "name",
        "secretKey"
      ],
      "type": "object"
    },
    "SecretFingerprint": {
      "description": "8 lowercase hex characters: the sha256 prefix of the plaintext",
      "pattern": "^[0-9a-f]{8}$",
      "type": "string"
    },
    "SecretRequestItem": {
      "description": "The lead needs a secret. The app shows a masked field; the value never enters the transcript: it is sealed to the\nsink's machine and answered with `secret_submit`, naming `requestId`. Only its fingerprint comes back.",
      "properties": {
        "answeredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "by": {
          "description": "The key name of the person who answered.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "envName": {
          "$ref": "#/$defs/EnvName",
          "description": "An `env:` sink: the variable it writes, when not the one `name` gives (`secrets::secret_env_name`)."
        },
        "fingerprint": {
          "$ref": "#/$defs/SecretFingerprint",
          "description": "Once stored."
        },
        "name": {
          "description": "The secret's key, e.g. `stripe.test_key`.",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "note": {
          "description": "Why it is open again, or why it could not be stored.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "requestId": {
          "$ref": "#/$defs/ChatRequestId"
        },
        "sink": {
          "$ref": "#/$defs/SecretSink"
        },
        "state": {
          "$ref": "#/$defs/SecretRequestState"
        },
        "text": {
          "description": "One line: why the lead needs it.",
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "name",
        "text",
        "sink",
        "state"
      ],
      "type": "object"
    },
    "SecretRequestState": {
      "enum": [
        "open",
        "stored",
        "withdrawn"
      ],
      "type": "string",
      "x-open": true
    },
    "SecretSink": {
      "type": "string"
    },
    "SetupInput": {
      "type": "string"
    },
    "SkillName": {
      "description": "Lowercase letters, digits and single hyphens, at most 64 characters",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "TableBlock": {
      "description": "Rows of plain-text cells, one per column.",
      "properties": {
        "columns": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 200,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 100,
          "type": "array"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "TaskId": {
      "pattern": "^T[1-9][0-9]*$",
      "type": "string"
    },
    "ThreadId": {
      "type": "string"
    },
    "ThreadRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        }
      },
      "required": [
        "machineId",
        "threadId"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "ToolPermission": {
      "description": "An approval raised by a session's tool permission prompt instead of a gated command: answering it answers the prompt\non the project's node. Its machine is the request's project's.",
      "properties": {
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "description": "The command, the path, or the tool's own description.",
          "maxLength": 2000,
          "type": "string"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "toolName": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "requestId",
        "toolName",
        "summary"
      ],
      "type": "object"
    },
    "WebPreview": {
      "description": "How a project's web app is built and run for a preview, each command with `sh -c` in the preview's worktree and\nthe project's variables, as setup commands run (#501).",
      "properties": {
        "build": {
          "description": "Builds the app; none for an app the start command builds itself.",
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "description": "Files whose contents decide what setup makes, such as lockfiles.",
          "items": {
            "$ref": "#/$defs/SetupInput"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "ready": {
          "$ref": "#/$defs/ReadyPath",
          "default": "/",
          "description": "Asked until it answers, for at most 2 minutes after the start."
        },
        "setup": {
          "default": [],
          "description": "Run first, in order: install dependencies, generate code. Skipped when `inputs` haven't changed since a\npreview of this project last ran them on this machine.",
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "^[^\\r\\n]*$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "start": {
          "description": "Serves the app on `127.0.0.1:$PORT`; it runs until the preview ends.",
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        }
      },
      "required": [
        "start"
      ],
      "type": "object"
    },
    "WorkstreamId": {
      "pattern": "^W[1-9][0-9]*$",
      "type": "string"
    }
  },
  "$ref": "#/$defs/ChatMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
