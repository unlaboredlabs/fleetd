{
  "$defs": {
    "AppClientMessage": {
      "oneOf": [
        {
          "properties": {
            "key": {
              "minLength": 1,
              "type": "string"
            },
            "t": {
              "const": "auth",
              "type": "string"
            }
          },
          "required": [
            "t",
            "key"
          ],
          "type": "object"
        },
        {
          "properties": {
            "t": {
              "const": "snapshot",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        },
        {
          "description": "Stream HubEvents after `cursor` as they happen.",
          "properties": {
            "cursor": {
              "$ref": "#/$defs/EventSeq"
            },
            "t": {
              "const": "events",
              "type": "string"
            }
          },
          "required": [
            "t",
            "cursor"
          ],
          "type": "object"
        },
        {
          "description": "Call one MCP tool with the session's key: same tools, grants and limits as /mcp. `input` is the tool's input;\nanswered by a `result` or an `error` carrying the same `id`.",
          "properties": {
            "id": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "input": true,
            "t": {
              "const": "call",
              "type": "string"
            },
            "tool": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "t",
            "id",
            "tool",
            "input"
          ],
          "type": "object"
        },
        {
          "description": "Subscribe to `live` frames, replacing any earlier subscription: every open order's lanes when `board`, and\nthe focused order's lanes, its project's lead and their streamed text when `focus` is set. Neither: stop.\nSend it again on window activation; the first frame after each one is `full`.",
          "properties": {
            "board": {
              "type": "boolean"
            },
            "focus": {
              "$ref": "#/$defs/WorkstreamId"
            },
            "t": {
              "const": "live",
              "type": "string"
            }
          },
          "required": [
            "t",
            "board"
          ],
          "type": "object"
        },
        {
          "description": "Subscribe to `chat_delta` frames of one project's chat, replacing any earlier one; without `project`, stop.\nSend it again after a reconnect.",
          "properties": {
            "project": {
              "$ref": "#/$defs/ProjectRef"
            },
            "t": {
              "const": "chat",
              "type": "string"
            }
          },
          "required": [
            "t"
          ],
          "type": "object"
        }
      ]
    },
    "EventSeq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "WorkstreamId": {
      "pattern": "^W[1-9][0-9]*$",
      "type": "string"
    }
  },
  "$ref": "#/$defs/AppClientMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
