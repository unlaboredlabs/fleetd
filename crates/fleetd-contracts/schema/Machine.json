{
  "$defs": {
    "BoxPublicKey": {
      "type": "string"
    },
    "Machine": {
      "properties": {
        "boxPubKey": {
          "$ref": "#/$defs/BoxPublicKey",
          "description": "M8: the node's X25519 key from its hello; clients seal this machine's secrets to it. Absent: it takes no\nsecrets."
        },
        "degradedReason": {
          "description": "Plain language, set while status is \"degraded\".",
          "type": "string"
        },
        "lastSeenAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastSlept": {
          "$ref": "#/$defs/SleptSpan",
          "description": "The machine's latest sleep its node reported on waking."
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "name": {
          "type": "string"
        },
        "nodeVersion": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MachineStatus"
        },
        "tags": {
          "default": [],
          "description": "Always empty: machines have no tags. Kept for older apps, which read the list.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "machineId",
        "name",
        "status",
        "lastSeenAt",
        "nodeVersion"
      ],
      "type": "object"
    },
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "MachineStatus": {
      "enum": [
        "online",
        "offline",
        "degraded"
      ],
      "type": "string"
    },
    "SleptSpan": {
      "description": "A span a machine spent asleep, epoch milliseconds; `machine.slept` carries the same fields as its data.",
      "properties": {
        "fromMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "toMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fromMs",
        "toMs"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$ref": "#/$defs/Machine",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
