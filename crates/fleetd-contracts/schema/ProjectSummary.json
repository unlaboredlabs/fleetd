{
  "$defs": {
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "description": "A project: a workspace with a lead and its own directory, on its home machine, where the lead runs. Its\n`projectId` is the node's id for that directory, so the ref also addresses the files; the directory may be a git\nrepo or a plain folder. A project holds zero or more repos (`ProjectRepo`), each in a node directory of its\nown or in the project's.",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "ProjectRepo": {
      "properties": {
        "base": {
          "description": "The branch its work lands on; absent until fleetd knows it.",
          "maxLength": 250,
          "minLength": 1,
          "pattern": "^[^\\r\\n]*$",
          "type": "string"
        },
        "checkout": {
          "$ref": "#/$defs/ProjectRef",
          "description": "The node's directory holding its files: the project's own `ProjectRef` when the project's directory is this\nrepo."
        },
        "name": {
          "$ref": "#/$defs/RepoName"
        },
        "repoId": {
          "$ref": "#/$defs/RepoId"
        },
        "repoKey": {
          "$ref": "#/$defs/RepoKey",
          "description": "Its origin remote, shortened; absent for a repo with no remote, or before fleetd has read it."
        }
      },
      "required": [
        "repoId",
        "name",
        "checkout"
      ],
      "type": "object"
    },
    "ProjectSummary": {
      "properties": {
        "lastActivityAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "repos": {
          "description": "The git repos it holds, from the hub; none for a plain directory, from a node, and from an older hub.",
          "items": {
            "$ref": "#/$defs/ProjectRepo"
          },
          "type": "array"
        },
        "threads": {
          "$ref": "#/$defs/ThreadCounts"
        },
        "title": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        }
      },
      "required": [
        "machineId",
        "projectId",
        "title",
        "workspaceRoot",
        "threads",
        "lastActivityAt"
      ],
      "type": "object"
    },
    "RepoId": {
      "pattern": "^R[1-9][0-9]*$",
      "type": "string"
    },
    "RepoKey": {
      "type": "string"
    },
    "RepoName": {
      "description": "Repo name, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "ThreadCounts": {
      "properties": {
        "failed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "idle": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "waiting": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "running",
        "waiting",
        "idle",
        "failed"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$ref": "#/$defs/ProjectSummary",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
