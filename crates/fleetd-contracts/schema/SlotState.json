{
  "$defs": {
    "MachineId": {
      "description": "Machine slug, [a-z0-9-]{1,32}",
      "pattern": "^[a-z0-9-]{1,32}$",
      "type": "string"
    },
    "ProjectId": {
      "type": "string"
    },
    "ProjectRef": {
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "machineId",
        "projectId"
      ],
      "type": "object"
    },
    "SlotState": {
      "properties": {
        "cap": {
          "description": "Global cap on running turns.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "perProject": {
          "items": {
            "$ref": "#/$defs/SlotStatePerProject"
          },
          "maxItems": 50,
          "type": "array"
        },
        "queued": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "reservedBand": {
          "description": "Slots of the cap only lead turns may take.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "used": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cap",
        "used",
        "queued",
        "reservedBand",
        "perProject"
      ],
      "type": "object"
    },
    "SlotStatePerProject": {
      "properties": {
        "maxAgents": {
          "description": "The most of the project's agents (its tasks: writers, readers, reviewers) that run at once; its lead's own\nturns don't count. The fleet `cap` until set.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "projectRef": {
          "$ref": "#/$defs/ProjectRef"
        },
        "queued": {
          "description": "Its agents waiting for a slot, paused ones included.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "running": {
          "description": "Its agents running now. Above `maxAgents` right after the cap was lowered: nothing is stopped for it.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "used": {
          "description": "Every slot it holds, its lead's turns included.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "projectRef",
        "maxAgents",
        "running",
        "queued",
        "used"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/SlotState",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
