#!/bin/sh
# The controlled head-to-head speed bench: claude -p (ungated, and claude-p+gate: its result through a PR, fleetd's
# review, CI and a merge) vs fleetd (vs an imported T3 Code run) on hidden-checked tasks.
# Method and results: docs/build/BENCH.md in the plan repo (wynn-dev/t3-fork-plan).
#   scripts/bench-vs --suite [--contenders claude-p,claude-p+gate,fleetd] [--repeat N]   # in sequence; then the table
#   scripts/bench-vs --task <task> --contender <claude-p|fleetd|t3|reference> [options]
#   scripts/bench-vs --finish <run-dir> --start <iso> --end <iso>   # imports a T3 Code run prepared with --contender t3
#   scripts/bench-vs --table | --list | --publish | --unhide
# Needs `npm ci --prefix tests/lab` once.
exec node "$(dirname "$0")/../tests/lab/bench/benchVs.ts" "$@"
