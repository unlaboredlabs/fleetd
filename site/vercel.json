{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh mobile-updates.sh fetch && node media.mjs build && npm ci --prefix ../docs/site --no-audit --no-fund && npm run build --prefix ../docs/site && npx --yes pagefind@1.5.2 --site docs",
  "ignoreCommand": "sh mobile-updates.sh unchanged && node media.mjs unchanged",
  "outputDirectory": ".",
  "cleanUrls": true,
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/docs/cli",
      "destination": "/docs/reference/cli",
      "permanent": true
    },
    {
      "source": "/docs/projects-and-orders",
      "destination": "/docs/projects",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/updates",
      "has": [
        {
          "type": "header",
          "key": "expo-channel-name",
          "value": "^(?<channel>edge|stable)$"
        },
        {
          "type": "header",
          "key": "expo-runtime-version",
          "value": "^(?<runtime>[A-Za-z0-9][A-Za-z0-9._-]{0,127})$"
        },
        {
          "type": "header",
          "key": "expo-platform",
          "value": "^(?<platform>ios|android)$"
        }
      ],
      "destination": "/updates/:channel/:runtime/:platform"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^(curl|Wget|fetch)/.*"
        }
      ],
      "destination": "/install.sh"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ],
  "headers": [
    {
      "source": "/updates",
      "headers": [
        {
          "key": "Content-Type",
          "value": "multipart/mixed; boundary=fleetd-update"
        },
        {
          "key": "expo-protocol-version",
          "value": "1"
        },
        {
          "key": "expo-sfv-version",
          "value": "0"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=0"
        },
        {
          "key": "Vary",
          "value": "expo-channel-name, expo-runtime-version, expo-platform"
        }
      ]
    },
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^(curl|Wget|fetch)/.*"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    }
  ]
}
