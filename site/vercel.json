{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh mobile-updates.sh fetch && node media.mjs build && npm ci --prefix ../docs/site --no-audit --no-fund && npm run build --prefix ../docs/site && npx --yes pagefind@1.5.2 --site docs",
  "ignoreCommand": "sh mobile-updates.sh unchanged && node media.mjs unchanged",
  "outputDirectory": ".",
  "cleanUrls": true,
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/docs/cli{/}?",
      "destination": "/docs/reference/cli",
      "permanent": true
    },
    {
      "source": "/docs/concepts{/}?",
      "destination": "/docs/how-fleetd-works",
      "permanent": true
    },
    {
      "source": "/docs/projects-and-orders{/}?",
      "destination": "/docs/bots",
      "permanent": true
    },
    {
      "source": "/docs/navi{/}?",
      "destination": "/docs/bots",
      "permanent": true
    },
    {
      "source": "/docs/projects{/}?",
      "destination": "/docs/bots",
      "permanent": true
    },
    {
      "source": "/docs/time-inspector{/}?",
      "destination": "/docs/agent-time",
      "permanent": true
    },
    {
      "source": "/docs/integrations{/}?",
      "destination": "/docs/connections",
      "permanent": true
    },
    {
      "source": "/docs/moving-a-hub{/}?",
      "destination": "/docs/moving-a-workspace",
      "permanent": true
    },
    {
      "source": "/docs/several-hubs{/}?",
      "destination": "/docs/several-workspaces",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/download/mac{/}?",
      "destination": "/api/download-mac"
    },
    {
      "source": "/updates",
      "has": [
        {
          "type": "header",
          "key": "expo-channel-name",
          "value": "^(?<channel>edge)$"
        },
        {
          "type": "header",
          "key": "eas-client-id",
          "value": "^(0[0-9A-Fa-f]|1[0-9Aa])[0-9A-Fa-f-]{34}$"
        },
        {
          "type": "header",
          "key": "expo-runtime-version",
          "value": "^(?<runtime>[A-Za-z0-9][A-Za-z0-9._-]{0,127})$"
        },
        {
          "type": "header",
          "key": "expo-platform",
          "value": "^(?<platform>ios|android)$"
        }
      ],
      "destination": "/updates/:channel/stage10/:runtime/:platform"
    },
    {
      "source": "/updates",
      "has": [
        {
          "type": "header",
          "key": "expo-channel-name",
          "value": "^(?<channel>edge)$"
        },
        {
          "type": "header",
          "key": "eas-client-id",
          "value": "^[0-7][0-9A-Fa-f-]{35}$"
        },
        {
          "type": "header",
          "key": "expo-runtime-version",
          "value": "^(?<runtime>[A-Za-z0-9][A-Za-z0-9._-]{0,127})$"
        },
        {
          "type": "header",
          "key": "expo-platform",
          "value": "^(?<platform>ios|android)$"
        }
      ],
      "destination": "/updates/:channel/stage50/:runtime/:platform"
    },
    {
      "source": "/updates",
      "has": [
        {
          "type": "header",
          "key": "expo-channel-name",
          "value": "^(?<channel>edge|stable)$"
        },
        {
          "type": "header",
          "key": "expo-runtime-version",
          "value": "^(?<runtime>[A-Za-z0-9][A-Za-z0-9._-]{0,127})$"
        },
        {
          "type": "header",
          "key": "expo-platform",
          "value": "^(?<platform>ios|android)$"
        }
      ],
      "destination": "/updates/:channel/:runtime/:platform"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^(curl|Wget|fetch)/.*"
        }
      ],
      "destination": "/install.sh"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://media.unlabored.net; media-src 'self' https://media.unlabored.net; font-src 'self' data:; connect-src 'self' https://accounts.fleetd.dev; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/updates",
      "headers": [
        {
          "key": "Content-Type",
          "value": "multipart/mixed; boundary=fleetd-update"
        },
        {
          "key": "expo-protocol-version",
          "value": "1"
        },
        {
          "key": "expo-sfv-version",
          "value": "0"
        },
        {
          "key": "Cache-Control",
          "value": "private, max-age=0"
        },
        {
          "key": "Vary",
          "value": "expo-channel-name, expo-runtime-version, expo-platform"
        }
      ]
    },
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^(curl|Wget|fetch)/.*"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    }
  ]
}
