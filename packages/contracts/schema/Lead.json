{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Lead",
  "$defs": {
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "ThreadId": {
      "type": "string",
      "minLength": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "UsageClass": {
      "type": "string",
      "enum": [
        "usage_limit",
        "rate_limit",
        "pool_exhausted"
      ]
    },
    "UsageParked": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/UsageClass"
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        },
        "resumeAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "class",
        "since"
      ],
      "additionalProperties": true
    },
    "Lead": {
      "type": "object",
      "properties": {
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "state": {
          "type": "string",
          "enum": [
            "starting",
            "idle",
            "working",
            "stalled",
            "stopped"
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastWakeAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "sessionGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parked": {
          "$ref": "#/$defs/UsageParked"
        }
      },
      "required": [
        "projectRef",
        "threadId",
        "state",
        "startedAt",
        "sessionGeneration"
      ],
      "additionalProperties": true
    }
  }
}
