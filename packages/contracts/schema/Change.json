{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Change",
  "$defs": {
    "ChangeId": {
      "type": "string",
      "pattern": "^X[1-9][0-9]*$"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "GitHubRepo": {
      "type": "string",
      "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,38})\\/([A-Za-z0-9._-]{1,100})$"
    },
    "GitHubPrUrl": {
      "type": "string",
      "pattern": "^https:\\/\\/github\\.com\\/([A-Za-z0-9][A-Za-z0-9-]{0,38}\\/[A-Za-z0-9._-]{1,100})\\/pull\\/([1-9][0-9]*)$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^T[1-9][0-9]*$"
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "Serves": {
      "type": "string"
    },
    "CommitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Full lowercase hex commit SHA, 40 or 64 characters"
    },
    "PatchId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Full lowercase hex patch id, 40 or 64 characters"
    },
    "ChangeReview": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "prHeadSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "patchId": {
          "$ref": "#/$defs/PatchId"
        },
        "blocking": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonBlocking": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "taskId",
        "prHeadSha",
        "patchId",
        "blocking",
        "nonBlocking"
      ],
      "additionalProperties": true
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Change": {
      "type": "object",
      "properties": {
        "changeId": {
          "$ref": "#/$defs/ChangeId"
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "repo": {
          "$ref": "#/$defs/GitHubRepo"
        },
        "prNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "prUrl": {
          "$ref": "#/$defs/GitHubPrUrl"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "serves": {
          "$ref": "#/$defs/Serves"
        },
        "tier": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "headSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "patchId": {
          "$ref": "#/$defs/PatchId"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "reviewing",
            "ready",
            "rebasing",
            "ci",
            "merging",
            "merged",
            "needs_rebase",
            "ci_failed",
            "refused",
            "abandoned"
          ]
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeReview"
          }
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastError": {
          "type": "string",
          "maxLength": 2000
        },
        "mergedSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "changeId",
        "projectRef",
        "repo",
        "prNumber",
        "prUrl",
        "branch",
        "workstreamId",
        "serves",
        "tier",
        "headSha",
        "state",
        "reviews",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": true
    }
  }
}
