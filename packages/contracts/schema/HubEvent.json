{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HubEvent",
  "$defs": {
    "EventSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "HubEventType": {
      "type": "string",
      "enum": [
        "machine.online",
        "machine.offline",
        "machine.degraded",
        "project.removed",
        "thread.started",
        "thread.completed",
        "thread.failed",
        "thread.interrupted",
        "thread.waiting",
        "thread.usage_limited",
        "thread.stalled",
        "wake.fired",
        "wake.missed",
        "write.delivered",
        "write.expired",
        "webhook.failing",
        "workstream.created",
        "workstream.running",
        "workstream.state",
        "ask.created",
        "ask.auto",
        "batch.ready",
        "decision.recorded",
        "lead.started",
        "lead.woken",
        "digest.ready",
        "task.queued",
        "task.started",
        "task.completed",
        "task.failed",
        "task.cancelled",
        "task.out_of_area",
        "lease.stale",
        "claim.failed",
        "claim.passed",
        "workstream.done",
        "review.verdict",
        "incident.recorded",
        "change.queued",
        "change.ready",
        "change.needs_rebase",
        "change.ci_failed",
        "pr.merged",
        "train.frozen",
        "train.resumed",
        "change.refused",
        "intake.routed",
        "research.verdict",
        "usage.breaker",
        "usage.resumed",
        "ask.secret_saved",
        "gated.ran",
        "push.sent"
      ]
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "ThreadId": {
      "type": "string",
      "minLength": 1
    },
    "HubEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "#/$defs/EventSeq"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "type": {
          "$ref": "#/$defs/HubEventType"
        },
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "data": {}
      },
      "required": [
        "seq",
        "at",
        "type",
        "summary"
      ],
      "additionalProperties": true
    }
  }
}
