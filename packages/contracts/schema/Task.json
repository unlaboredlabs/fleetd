{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Task",
  "$defs": {
    "TaskId": {
      "type": "string",
      "pattern": "^T[1-9][0-9]*$"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "AreaName": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Lowercase slug, [a-z0-9][a-z0-9_-]*, at most 40"
    },
    "ThreadId": {
      "type": "string",
      "minLength": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "done",
            "failed",
            "cancelled"
          ]
        },
        "tail": {
          "type": "string",
          "maxLength": 2000
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "prUrl": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "status",
        "tail",
        "at"
      ],
      "additionalProperties": true
    },
    "Task": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "write",
            "read",
            "review"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AreaName"
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "estimateMinutes": {
          "type": "number",
          "minimum": 0
        },
        "serves": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "idle",
            "done",
            "failed",
            "cancelled"
          ]
        },
        "queuedReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "threadRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "threadId": {
              "$ref": "#/$defs/ThreadId"
            }
          },
          "required": [
            "machineId",
            "threadId"
          ],
          "additionalProperties": true
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "worktreePath": {
          "type": "string",
          "pattern": "^\\/"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "result": {
          "$ref": "#/$defs/TaskResult"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "endedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "taskId",
        "projectRef",
        "workstreamId",
        "title",
        "kind",
        "prompt",
        "areas",
        "model",
        "effort",
        "state",
        "attempt",
        "createdAt"
      ],
      "additionalProperties": true
    }
  }
}
