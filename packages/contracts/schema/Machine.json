{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Machine",
  "$defs": {
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Machine": {
      "type": "object",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "online",
            "offline",
            "degraded"
          ]
        },
        "lastSeenAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "t3": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "protocol": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "version",
                "protocol"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "nodeVersion": {
          "type": "string"
        }
      },
      "required": [
        "machineId",
        "name",
        "tags",
        "status",
        "lastSeenAt",
        "t3",
        "nodeVersion"
      ],
      "additionalProperties": true
    }
  }
}
