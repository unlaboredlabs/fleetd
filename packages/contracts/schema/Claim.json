{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Claim",
  "$defs": {
    "ClaimId": {
      "type": "string",
      "pattern": "^C[1-9][0-9]*$"
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "CheckSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "pr_merged"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "pr": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ci_green"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "http"
              ]
            },
            "url": {
              "type": "string"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "contains": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "url",
            "status"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cmd"
              ]
            },
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1
            },
            "expectExit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "machineId",
            "argv",
            "expectExit"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "test"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "testId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "repo",
            "testId"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "judge"
              ]
            },
            "criteria": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "criteria"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "human"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "question"
          ],
          "additionalProperties": true
        }
      ]
    },
    "CheckResult": {
      "type": "object",
      "properties": {
        "checkIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spec": {
          "$ref": "#/$defs/CheckSpec"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error"
          ]
        },
        "evidence": {
          "type": "string",
          "maxLength": 2000
        },
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ranBy": {
          "type": "string",
          "enum": [
            "hub",
            "node",
            "judge",
            "human"
          ]
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "checkIndex",
        "spec",
        "result",
        "evidence",
        "ranBy",
        "at"
      ],
      "additionalProperties": true
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claimId": {
          "$ref": "#/$defs/ClaimId"
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "by": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "maxItems": 20
        },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        }
      },
      "required": [
        "claimId",
        "workstreamId",
        "by",
        "at",
        "results",
        "outcome"
      ],
      "additionalProperties": true
    }
  }
}
