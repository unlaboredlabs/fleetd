{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Incident",
  "$defs": {
    "IncidentId": {
      "type": "string",
      "pattern": "^I[1-9][0-9]*$"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^T[1-9][0-9]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Incident": {
      "type": "object",
      "properties": {
        "incidentId": {
          "$ref": "#/$defs/IncidentId"
        },
        "class": {
          "type": "string",
          "enum": [
            "false_claim",
            "estimate_miss",
            "polish_loop",
            "misfiled_ask",
            "out_of_area",
            "stall"
          ]
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 20
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "incidentId",
        "class",
        "projectRef",
        "evidence",
        "at"
      ],
      "additionalProperties": true
    }
  }
}
