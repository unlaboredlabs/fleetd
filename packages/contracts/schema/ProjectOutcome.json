{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProjectOutcome",
  "$defs": {
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ProjectSummary": {
      "type": "object",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "title": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        },
        "threads": {
          "type": "object",
          "properties": {
            "running": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "waiting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "idle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "running",
            "waiting",
            "idle",
            "failed"
          ],
          "additionalProperties": true
        },
        "lastActivityAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "machineId",
        "projectId",
        "title",
        "workspaceRoot",
        "threads",
        "lastActivityAt"
      ],
      "additionalProperties": true
    },
    "ThreadId": {
      "type": "string",
      "minLength": 1
    },
    "ThreadSummary": {
      "type": "object",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "waiting",
            "idle",
            "completed",
            "failed",
            "interrupted",
            "cancelled"
          ]
        },
        "headline": {
          "type": "string",
          "maxLength": 280
        },
        "latestMessageTail": {
          "type": "string",
          "maxLength": 4096
        },
        "lastError": {
          "type": "object",
          "properties": {
            "class": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "class",
            "message"
          ],
          "additionalProperties": true
        },
        "usageLimitResetAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastProgressAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        },
        "asOf": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "machineId",
        "threadId",
        "projectId",
        "title",
        "status",
        "headline",
        "latestMessageTail",
        "lastProgressAt",
        "stale",
        "asOf"
      ],
      "additionalProperties": true
    },
    "UsageClass": {
      "type": "string",
      "enum": [
        "usage_limit",
        "rate_limit",
        "pool_exhausted"
      ]
    },
    "UsageParked": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/UsageClass"
        },
        "since": {
          "$ref": "#/$defs/Timestamp"
        },
        "resumeAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "class",
        "since"
      ],
      "additionalProperties": true
    },
    "Lead": {
      "type": "object",
      "properties": {
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "threadId": {
          "$ref": "#/$defs/ThreadId"
        },
        "state": {
          "type": "string",
          "enum": [
            "starting",
            "idle",
            "working",
            "stalled",
            "stopped"
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "lastWakeAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "sessionGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parked": {
          "$ref": "#/$defs/UsageParked"
        }
      },
      "required": [
        "projectRef",
        "threadId",
        "state",
        "startedAt",
        "sessionGeneration"
      ],
      "additionalProperties": true
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "CheckSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "pr_merged"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "pr": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ci_green"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "http"
              ]
            },
            "url": {
              "type": "string"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "contains": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "url",
            "status"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cmd"
              ]
            },
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1
            },
            "expectExit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "machineId",
            "argv",
            "expectExit"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "test"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "testId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "repo",
            "testId"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "judge"
              ]
            },
            "criteria": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "criteria"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "human"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "question"
          ],
          "additionalProperties": true
        }
      ]
    },
    "Estimate": {
      "type": "object",
      "properties": {
        "rawMinutes": {
          "type": "number",
          "minimum": 0
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 20
        }
      },
      "required": [
        "rawMinutes",
        "gates"
      ],
      "additionalProperties": true
    },
    "DecisionRule": {
      "type": "object",
      "properties": {
        "better": {
          "type": "string",
          "enum": [
            "higher",
            "lower"
          ]
        },
        "goAtLeast": {
          "type": "number"
        },
        "stopBelow": {
          "type": "number"
        }
      },
      "required": [
        "better",
        "goAtLeast",
        "stopBelow"
      ],
      "additionalProperties": true
    },
    "Brief": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 20
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 20
        },
        "doneWhen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckSpec"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "budget": {
          "type": "object",
          "properties": {
            "agentHours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        },
        "estimate": {
          "$ref": "#/$defs/Estimate"
        },
        "baseline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\r\\n]*$"
        },
        "decisionRule": {
          "$ref": "#/$defs/DecisionRule"
        }
      },
      "required": [
        "goal",
        "why",
        "pointers",
        "constraints",
        "doneWhen",
        "tier"
      ],
      "additionalProperties": true
    },
    "BriefHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Headline": {
      "type": "string",
      "maxLength": 280,
      "pattern": "^[^\\r\\n]*$"
    },
    "PlaybookRef": {
      "type": "string",
      "pattern": "^(?:bugfix|feature|research|finish-all)@(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "<playbook name>@<full lowercase hex git blob SHA>"
    },
    "MetricValues": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "number"
        },
        "candidate": {
          "type": "number"
        }
      },
      "required": [
        "baseline",
        "candidate"
      ],
      "additionalProperties": true
    },
    "ResearchVerdict": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "go",
            "stop",
            "inconclusive"
          ]
        },
        "metricValues": {
          "$ref": "#/$defs/MetricValues"
        },
        "rule": {
          "$ref": "#/$defs/DecisionRule"
        },
        "computedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "outcome",
        "metricValues",
        "rule",
        "computedAt"
      ],
      "additionalProperties": true
    },
    "Workstream": {
      "type": "object",
      "properties": {
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "channel": {
              "type": "string",
              "enum": [
                "app",
                "phone",
                "mcp",
                "lead"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "required": [
            "text",
            "channel",
            "by",
            "at"
          ],
          "additionalProperties": true
        },
        "brief": {
          "$ref": "#/$defs/Brief"
        },
        "briefHash": {
          "$ref": "#/$defs/BriefHash"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "running",
            "converging",
            "verifying",
            "done",
            "idle",
            "stopped",
            "failed"
          ]
        },
        "headline": {
          "$ref": "#/$defs/Headline"
        },
        "headlineAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "estimateActual": {
          "type": "object",
          "properties": {
            "actualMinutes": {
              "type": "number",
              "minimum": 0
            },
            "ratioAtStart": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "ratioAtStart"
          ],
          "additionalProperties": true
        },
        "playbook": {
          "$ref": "#/$defs/PlaybookRef"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "go",
            "stop",
            "inconclusive"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/ResearchVerdict"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "workstreamId",
        "projectRef",
        "title",
        "source",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": true
    },
    "TaskId": {
      "type": "string",
      "pattern": "^T[1-9][0-9]*$"
    },
    "AreaName": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Lowercase slug, [a-z0-9][a-z0-9_-]*, at most 40"
    },
    "Serves": {
      "type": "string"
    },
    "Receipts": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "commandsFailed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filesChanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "commands",
        "commandsFailed",
        "filesChanged",
        "toolCalls"
      ],
      "additionalProperties": true
    },
    "TaskResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "done",
            "failed",
            "cancelled"
          ]
        },
        "tail": {
          "type": "string",
          "maxLength": 2000
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "prUrl": {
          "type": "string"
        },
        "receipts": {
          "$ref": "#/$defs/Receipts"
        },
        "claimsUnverified": {
          "type": "boolean"
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "status",
        "tail",
        "at"
      ],
      "additionalProperties": true
    },
    "Task": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/TaskId"
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "write",
            "read",
            "review"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AreaName"
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        "tier": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "estimateMinutes": {
          "type": "number",
          "minimum": 0
        },
        "serves": {
          "$ref": "#/$defs/Serves"
        },
        "qa": {
          "type": "boolean"
        },
        "pr": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "idle",
            "done",
            "failed",
            "cancelled"
          ]
        },
        "queuedReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "threadRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "threadId": {
              "$ref": "#/$defs/ThreadId"
            }
          },
          "required": [
            "machineId",
            "threadId"
          ],
          "additionalProperties": true
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "worktreePath": {
          "type": "string",
          "pattern": "^\\/"
        },
        "parked": {
          "$ref": "#/$defs/UsageParked"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "result": {
          "$ref": "#/$defs/TaskResult"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "endedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "taskId",
        "projectRef",
        "workstreamId",
        "title",
        "kind",
        "prompt",
        "areas",
        "model",
        "effort",
        "state",
        "attempt",
        "createdAt"
      ],
      "additionalProperties": true
    },
    "ProjectOutcome": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ProjectSummary"
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThreadSummary"
          },
          "maxItems": 20
        },
        "lead": {
          "$ref": "#/$defs/Lead"
        },
        "workstreams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Workstream"
          },
          "maxItems": 20
        },
        "taskCounts": {
          "type": "object",
          "properties": {
            "queued": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "running": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "idle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "done": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "queued",
            "running",
            "idle",
            "done",
            "failed",
            "cancelled"
          ],
          "additionalProperties": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          },
          "maxItems": 20
        },
        "stale": {
          "type": "boolean"
        },
        "asOf": {
          "$ref": "#/$defs/Timestamp"
        },
        "next": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "threads",
        "stale",
        "asOf"
      ],
      "additionalProperties": true
    }
  }
}
