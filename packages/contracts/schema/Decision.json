{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Decision",
  "$defs": {
    "DecisionId": {
      "type": "string",
      "pattern": "^D[1-9][0-9]*$"
    },
    "DecisionKey": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)*$",
      "description": "Lowercase dotted slug, [a-z0-9]+(.[a-z0-9_-]+)*, at most 80"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "DecisionScope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "global"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "project"
              ]
            },
            "projectRef": {
              "type": "object",
              "properties": {
                "machineId": {
                  "$ref": "#/$defs/MachineId"
                },
                "projectId": {
                  "$ref": "#/$defs/ProjectId"
                }
              },
              "required": [
                "machineId",
                "projectId"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "kind",
            "projectRef"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "workstream"
              ]
            },
            "workstreamId": {
              "$ref": "#/$defs/WorkstreamId"
            }
          },
          "required": [
            "kind",
            "workstreamId"
          ],
          "additionalProperties": true
        }
      ]
    },
    "AskId": {
      "type": "string",
      "pattern": "^A[1-9][0-9]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Decision": {
      "type": "object",
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/DecisionId"
        },
        "key": {
          "$ref": "#/$defs/DecisionKey"
        },
        "scope": {
          "$ref": "#/$defs/DecisionScope"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "enum": [
            "human",
            "lead"
          ]
        },
        "askId": {
          "$ref": "#/$defs/AskId"
        },
        "supersedes": {
          "$ref": "#/$defs/DecisionId"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "retired"
          ]
        },
        "at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "decisionId",
        "key",
        "scope",
        "value",
        "source",
        "state",
        "at"
      ],
      "additionalProperties": true
    }
  }
}
