{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Workstream",
  "$defs": {
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "CheckSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "pr_merged"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "pr": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ci_green"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "http"
              ]
            },
            "url": {
              "type": "string"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "contains": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "url",
            "status"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cmd"
              ]
            },
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1
            },
            "expectExit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "machineId",
            "argv",
            "expectExit"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "test"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "testId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "repo",
            "testId"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "judge"
              ]
            },
            "criteria": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "criteria"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "human"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "question"
          ],
          "additionalProperties": true
        }
      ]
    },
    "Brief": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 20
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "maxItems": 20
        },
        "doneWhen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckSpec"
          },
          "maxItems": 20,
          "minItems": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "budget": {
          "type": "object",
          "properties": {
            "agentHours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        },
        "estimate": {
          "type": "object",
          "properties": {
            "rawMinutes": {
              "type": "number",
              "minimum": 0
            },
            "gates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 20
            }
          },
          "required": [
            "rawMinutes",
            "gates"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "goal",
        "why",
        "pointers",
        "constraints",
        "doneWhen",
        "tier"
      ],
      "additionalProperties": true
    },
    "BriefHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Headline": {
      "type": "string",
      "maxLength": 280,
      "pattern": "^[^\\r\\n]*$"
    },
    "Workstream": {
      "type": "object",
      "properties": {
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "channel": {
              "type": "string",
              "enum": [
                "app",
                "phone",
                "mcp",
                "lead"
              ]
            },
            "by": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "required": [
            "text",
            "channel",
            "by",
            "at"
          ],
          "additionalProperties": true
        },
        "brief": {
          "$ref": "#/$defs/Brief"
        },
        "briefHash": {
          "$ref": "#/$defs/BriefHash"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "running",
            "converging",
            "verifying",
            "done",
            "idle",
            "stopped",
            "failed"
          ]
        },
        "headline": {
          "$ref": "#/$defs/Headline"
        },
        "headlineAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "workstreamId",
        "projectRef",
        "title",
        "source",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": true
    }
  }
}
