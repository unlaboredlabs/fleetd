{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProjectSummary",
  "$defs": {
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ProjectSummary": {
      "type": "object",
      "properties": {
        "machineId": {
          "$ref": "#/$defs/MachineId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "title": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        },
        "threads": {
          "type": "object",
          "properties": {
            "running": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "waiting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "idle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "running",
            "waiting",
            "idle",
            "failed"
          ],
          "additionalProperties": true
        },
        "lastActivityAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "machineId",
        "projectId",
        "title",
        "workspaceRoot",
        "threads",
        "lastActivityAt"
      ],
      "additionalProperties": true
    }
  }
}
