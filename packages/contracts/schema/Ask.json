{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Ask",
  "$defs": {
    "AskId": {
      "type": "string",
      "pattern": "^A[1-9][0-9]*$"
    },
    "MachineId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Machine slug, [a-z0-9-]{1,32}"
    },
    "ProjectId": {
      "type": "string",
      "minLength": 1
    },
    "WorkstreamId": {
      "type": "string",
      "pattern": "^W[1-9][0-9]*$"
    },
    "DecisionKey": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)*$",
      "description": "Lowercase dotted slug, [a-z0-9]+(.[a-z0-9_-]+)*, at most 80"
    },
    "Step": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "where": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "browser",
                "phone"
              ]
            },
            {
              "$ref": "#/$defs/MachineId"
            }
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "text",
        "where"
      ],
      "additionalProperties": true
    },
    "CheckSpec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "pr_merged"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "pr": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ci_green"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "http"
              ]
            },
            "url": {
              "type": "string"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "contains": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "url",
            "status"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cmd"
              ]
            },
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1
            },
            "expectExit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "machineId",
            "argv",
            "expectExit"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "test"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "testId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "repo",
            "testId"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "judge"
              ]
            },
            "criteria": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "criteria"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "human"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "question"
          ],
          "additionalProperties": true
        }
      ]
    },
    "SecretSink": {
      "type": "string"
    },
    "SecretFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "8 lowercase hex characters: the sha256 prefix of the plaintext"
    },
    "EnvName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
    },
    "GatedRunSpec": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^\\/"
        },
        "class": {
          "type": "string",
          "enum": [
            "irreversible",
            "money",
            "credential"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "secretEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/EnvName"
              },
              "secretKey": {
                "$ref": "#/$defs/DecisionKey"
              }
            },
            "required": [
              "name",
              "secretKey"
            ],
            "additionalProperties": true
          },
          "maxItems": 20
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        }
      },
      "required": [
        "argv",
        "class",
        "reason",
        "timeoutSec"
      ],
      "additionalProperties": true
    },
    "BatchId": {
      "type": "string",
      "pattern": "^B[1-9][0-9]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "DecisionId": {
      "type": "string",
      "pattern": "^D[1-9][0-9]*$"
    },
    "Ask": {
      "type": "object",
      "properties": {
        "askId": {
          "$ref": "#/$defs/AskId"
        },
        "projectRef": {
          "type": "object",
          "properties": {
            "machineId": {
              "$ref": "#/$defs/MachineId"
            },
            "projectId": {
              "$ref": "#/$defs/ProjectId"
            }
          },
          "required": [
            "machineId",
            "projectId"
          ],
          "additionalProperties": true
        },
        "workstreamId": {
          "$ref": "#/$defs/WorkstreamId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "decide",
            "do",
            "secret",
            "approve"
          ]
        },
        "key": {
          "$ref": "#/$defs/DecisionKey"
        },
        "class": {
          "type": "string",
          "enum": [
            "product",
            "money",
            "credential",
            "irreversible"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 6
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 20
        },
        "verify": {
          "$ref": "#/$defs/CheckSpec"
        },
        "sink": {
          "$ref": "#/$defs/SecretSink"
        },
        "fingerprint": {
          "$ref": "#/$defs/SecretFingerprint"
        },
        "gated": {
          "$ref": "#/$defs/GatedRunSpec"
        },
        "evidence": {
          "type": "string",
          "maxLength": 2000
        },
        "blocks": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "nothing"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "proceededOnRec": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "auto",
            "answered",
            "defaulted",
            "withdrawn"
          ]
        },
        "batchId": {
          "$ref": "#/$defs/BatchId"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "answer": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/Timestamp"
            },
            "raw": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "by",
            "at",
            "raw"
          ],
          "additionalProperties": true
        },
        "decisionId": {
          "$ref": "#/$defs/DecisionId"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "askId",
        "kind",
        "key",
        "class",
        "text",
        "blocks",
        "proceededOnRec",
        "state",
        "createdAt"
      ],
      "additionalProperties": true
    }
  }
}
