{
  "name": "fleetd-compare",
  "private": true,
  "type": "module",
  "description": "Black-box tests and benchmarks of fleetd builds given as binaries (FLEETD_BIN), run against a hub of the build or another target.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "behaviour": "node behaviour.ts",
    "contract": "node contract.ts",
    "isolation": "node isolation.ts",
    "build-bench": "node build.ts",
    "bench": "node bench.ts",
    "soak": "node soak.ts",
    "desktop": "node desktop.ts",
    "report": "node report.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "7.0.2"
  }
}
