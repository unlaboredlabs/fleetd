{
  "name": "fleetd-lab",
  "private": true,
  "type": "module",
  "description": "End-to-end lab suite for the fleetd binary: a hub and nodes that run the real claude CLI, never in CI; and the factory lab (factory/), offline, which runs in CI.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lab": "node testLab.ts",
    "factory": "node factory/run.ts",
    "record-fixtures": "node failure/recordFixtures.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "7.0.2"
  }
}
