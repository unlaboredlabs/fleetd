{
  "name": "fleetd-desktop",
  "productName": "fleetd",
  "private": true,
  "version": "0.0.0",
  "description": "fleetd desktop app",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.qa.json --noEmit && tsc -p tsconfig.fixtures.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "qa:build": "VITE_FLEETD_GALLERY=1 electron-vite build",
    "qa": "playwright test -c qa/playwright.config.ts --project=screens",
    "qa:selftest": "playwright test -c qa/playwright.config.ts --project=selftest",
    "fixtures": "node fixtures/build.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1",
    "@tanstack/react-virtual": "3.14.21",
    "libsodium-wrappers": "0.8.4",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
