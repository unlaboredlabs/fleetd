{
  "name": "fleetd-desktop",
  "productName": "fleetd",
  "private": true,
  "version": "0.0.0",
  "description": "fleetd desktop app",
  "homepage": "https://fleetd.sh",
  "author": "fleetd contributors",
  "license": "MIT",
  "desktopName": "fleetd-desktop.desktop",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web:preview": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "qa:build": "VITE_FLEETD_QA=1 MAIN_VITE_FLEETD_TEST_BUILD=1 electron-vite build",
    "qa": "playwright test -c qa/playwright.config.ts --project=screens",
    "qa:selftest": "playwright test -c qa/playwright.config.ts --project=selftest",
    "site:shots": "QA_SCALE=2 playwright test -c qa/playwright.config.ts --project=site",
    "site:showcase": "QA_SCALE=3 playwright test -c qa/playwright.config.ts --project=showcase --workers=1",
    "fixtures": "node fixtures/build.ts",
    "perf": "node fixtures/build.ts && node perf/run.ts",
    "perf:record": "node fixtures/build.ts && node perf/record-smoke.ts",
    "perf:busy": "node fixtures/build.ts && node perf/busy.ts",
    "perf:toggles": "node fixtures/build.ts && node perf/toggles.ts",
    "perf:drops": "node fixtures/build.ts && node perf/drops.ts",
    "debug-guard-check": "node scripts/debug-guard-check.ts",
    "build:test": "MAIN_VITE_FLEETD_TEST_BUILD=1 electron-vite build"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1",
    "libsodium-wrappers": "0.8.4",
    "electron-updater": "6.8.9",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-virtual": "3.14.21",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.3",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "uqr": "0.1.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  }
}
