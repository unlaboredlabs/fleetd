{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The harness runs in Node 24 straight from .ts; its page callbacks run in the renderer.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.perf.tsbuildinfo"
  },
  "include": ["perf/**/*"]
}
