{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The harness runs in Node; dom/checks.ts runs in the renderer. The stand-in app's main.js is checked too.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.qa.tsbuildinfo"
  },
  // The words the composer fixtures answer, which QA types.
  "include": ["qa/**/*", "fixtures/composer/sends.ts"]
}
