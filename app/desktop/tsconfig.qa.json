{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The harness runs in Node; dom/checks.ts runs in the renderer. The stand-in app's main.js is checked too.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.qa.tsbuildinfo"
  },
  // The words the composer and offline fixtures answer or hold, which QA types, and the agent the agents fixture opens.
  "include": ["qa/**/*", "fixtures/composer/sends.ts", "fixtures/offline/sends.ts", "fixtures/agents/route.ts"]
}
