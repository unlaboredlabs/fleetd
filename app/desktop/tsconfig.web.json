  "include": ["src/renderer/src/**/*", "src/renderer/ui/**/*", "src/renderer/screens/**/*", "src/renderer/demo/**/*", "src/renderer/perf/**/*", "src/shared/**/*", "src/preload/api.d.ts", "fixtures/status/docs.ts"]
}
