{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"],
    // The built-ins Hermes, the phone's engine, has: ES2022's and src/hermes.d.ts's, never newer (expo's base says
    // ESNext), so one it lacks fails the typecheck rather than end the app on a phone.
    "lib": ["DOM", "ES2022"],
    // The repo's fakes (fleetd/test, as fleetd/fakes/accounts), which the tests import, name their imports' .ts.
    "allowImportingTsExtensions": true,
    // The desktop modules the app imports (src/desktop.ts) find React here, as Metro and vitest do.
    "paths": { "react": ["./node_modules/@types/react"] }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
